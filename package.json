{
  "name": "marks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-time collaborative markdown editor with Google Docs responsiveness, built on Eg-walker/Fugue CRDTs",
  "workspaces": [
    "client",
    "server",
    "esbt"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "npm run build --workspace=@marks/esbt",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=@marks/esbt && npm run build --workspace=client && npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "typecheck": "npm run typecheck --workspace=@marks/esbt && npm run typecheck --workspace=client && npm run typecheck --workspace=server",
    "clean": "rm -rf client/dist server/dist esbt/dist node_modules/.vite",
    "test:esbt": "npm test --workspace=@marks/esbt",
    "test:browser": "node --experimental-strip-types --test client/src/browser/*.test.ts",
    "test:harness": "node --test scripts/harness/*.test.mjs",
    "harness:probe": "node scripts/harness/probe.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:surface": "node scripts/harness/run.mjs --driver=playwright",
    "smoke:playwright": "node scripts/harness/run.mjs --driver=playwright",
    "smoke:puppeteer": "node scripts/harness/run.mjs --driver=puppeteer",
    "smoke:agent-browser": "node scripts/harness/run.mjs --driver=agent-browser",
    "smoke:platforms": "node scripts/harness/run.mjs --driver=all",
    "measure": "node scripts/measure.mjs"
  },
  "devDependencies": {
    "agent-browser": "^0.34.0",
    "concurrently": "^9.2.1",
    "playwright": "^1.62.1",
    "puppeteer-core": "^25.8.0",
    "typescript": "^5.9.3"
  }
}
