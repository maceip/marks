{
  "name": "marks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-time collaborative markdown editor with Google Docs responsiveness, built on ESBT",
  "workspaces": [
    "client",
    "esbt"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "npm run build --workspace=@marks/esbt",
    "dev": "npm run dev --workspace=client",
    "dev:client": "npm run dev --workspace=client",
    "preview": "npm run preview --workspace=client",
    "build": "npm run build --workspace=@marks/esbt && npm run build --workspace=client",
    "pretypecheck": "npm run build --workspace=@marks/esbt",
    "typecheck": "npm run typecheck --workspace=@marks/esbt && npm run typecheck --workspace=client",
    "clean": "rm -rf client/dist esbt/dist node_modules/.vite",
    "test:esbt": "npm test --workspace=@marks/esbt",
    "test:browser": "node --experimental-strip-types --test client/src/browser/*.test.ts",
    "test:surface": "node --experimental-strip-types --test client/src/lib/posture.test.ts client/src/lib/ai-compose.test.ts client/src/editor/*.test.ts",
    "test:markdown": "node --experimental-strip-types --test client/src/markdown/*.test.ts",
    "test:auth": "node --experimental-strip-types --test client/src/auth/*.test.ts",
    "test:harness": "node --test scripts/harness/*.test.mjs",
    "harness:probe": "node scripts/harness/probe.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:surface": "node scripts/harness/run.mjs --driver=playwright",
    "smoke:playwright": "node scripts/harness/run.mjs --driver=playwright",
    "smoke:puppeteer": "node scripts/harness/run.mjs --driver=puppeteer",
    "smoke:agent-browser": "node scripts/harness/run.mjs --driver=agent-browser",
    "smoke:platforms": "node scripts/harness/run.mjs --driver=all",
    "measure": "node scripts/measure.mjs",
    "check:ui-budgets": "node scripts/check-ui-budgets.mjs"
  },
  "devDependencies": {
    "agent-browser": "^0.34.0",
    "playwright": "^1.62.1",
    "puppeteer-core": "^25.8.0",
    "typescript": "^5.9.3"
  }
}
