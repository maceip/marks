# ── marks.secure.build — marks-server (API, rooms, service-mode UI) ─────
# Appended to /etc/caddy/Caddyfile. CrowdSec already parses Caddy logs for
# HTTP floods; this site block drops scanner junk and caps request bodies
# before they reach the process.
marks.secure.build {
	encode zstd gzip
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https:; font-src 'self' data:; connect-src 'self' wss:; worker-src 'self' blob:; manifest-src 'self'"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self), payment=(), usb=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	request_body {
		# Browser import can carry the 1M-unit document policy as UTF-8 JSON;
		# asset upload is independently sniffed and capped at 10 MiB in Rust.
		max_size 12MiB
	}

	# Cache policy for /assets/* belongs to marks-server (headers.rs), which
	# sends the immutable policy only when the hashed asset actually exists.
	# Repeating it here duplicated the header and, worse, would stamp a 404
	# as immutable — poisoning browser caches beyond the reach of rollback.

	@flood `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 12582912`
	handle @flood {
		respond "payload too large" 413
	}

	@spam path /.env /.git* /wp-admin* /wp-login.php /xmlrpc.php /phpmyadmin* /cgi-bin* /vendor/phpunit* /actuator* /server-status
	handle @spam {
		abort
	}

	reverse_proxy 127.0.0.1:5192 {
		flush_interval -1
		header_up X-Real-IP {remote_host}
		# Release activation and rollback stop the old process before the
		# new one listens (~1s). Retry refused connections briefly instead
		# of answering an immediate 502. Established WebSockets still drop;
		# the client reconnect/resync path remains authoritative.
		lb_try_duration 3s
		lb_try_interval 250ms
		transport http {
			read_timeout 0
			write_timeout 0
			dial_timeout 5s
		}
	}
}
