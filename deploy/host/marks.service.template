[Unit]
Description=marks.secure.build — marks-server (127.0.0.1:5192)
Documentation=https://github.com/maceip/marks
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=devuser
Group=devuser
WorkingDirectory=/opt/marks/current
Environment=MARKS_LISTEN=127.0.0.1:5192
Environment=MARKS_DB=/var/lib/marks/marks.db3
Environment=MARKS_ASSET_DIR=/var/lib/marks/assets
Environment=MARKS_MAX_BUNDLE_EXPORTS=4
Environment=MARKS_BACKUP_DIR=/var/lib/marks/backups
Environment=MARKS_BACKUP_RETAIN=14
Environment=MARKS_ORIGIN=https://marks.secure.build
Environment=MARKS_STATIC_DIR=/opt/marks/current/static
Environment=RUST_LOG=info
ExecStart=/opt/marks/current/marks-server
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=60s
StandardOutput=journal
StandardError=journal
UMask=0077
StateDirectory=marks
TasksMax=512
LimitNOFILE=65536
MemoryHigh=2G
MemoryMax=3G

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ReadWritePaths=/var/lib/marks
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
