#!/usr/bin/python3
"""Bounded, link-free archive intake for the Marks deployment account."""

import os
import re
import shutil
import sys
import tarfile
import tempfile
from pathlib import Path, PurePosixPath

ROOT = Path("/var/lib/marks-deploy/incoming")
SHA_RE = re.compile(r"[0-9a-f]{40}")
MAX_ARCHIVE_BYTES = 512 * 1024 * 1024
MAX_EXPANDED_BYTES = 1024 * 1024 * 1024
MAX_MEMBERS = 50_000


class LimitedReader:
    def __init__(self, stream):
        self.stream = stream
        self.total = 0

    def read(self, size=-1):
        data = self.stream.read(size)
        self.total += len(data)
        if self.total > MAX_ARCHIVE_BYTES:
            raise ValueError("compressed archive exceeds 512 MiB")
        return data


def revision(value: str) -> str:
    if not SHA_RE.fullmatch(value):
        raise ValueError("revision must be exactly 40 lowercase hexadecimal characters")
    return value


def safe_name(raw: str) -> PurePosixPath:
    if not raw or "\x00" in raw or "\\" in raw:
        raise ValueError(f"unsafe archive path: {raw!r}")
    path = PurePosixPath(raw)
    if path.is_absolute() or any(part in ("", ".", "..") for part in path.parts):
        raise ValueError(f"unsafe archive path: {raw!r}")
    return path


def remove_tree(path: Path) -> None:
    try:
        st = path.lstat()
    except FileNotFoundError:
        return
    if not path.is_dir() or path.is_symlink():
        raise ValueError("refusing to remove a non-directory staging target")
    shutil.rmtree(path)


def upload(sha: str) -> None:
    ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
    final = ROOT / sha
    if final.exists() or final.is_symlink():
        raise ValueError("an upload for this revision already exists; run cleanup first")
    temporary = Path(tempfile.mkdtemp(prefix=f".{sha}.upload.", dir=ROOT))
    seen: set[PurePosixPath] = set()
    count = 0
    expanded = 0
    try:
        with tarfile.open(fileobj=LimitedReader(sys.stdin.buffer), mode="r|*") as archive:
            for member in archive:
                count += 1
                if count > MAX_MEMBERS:
                    raise ValueError("archive exceeds 50000 entries")
                name = safe_name(member.name)
                if name in seen:
                    raise ValueError(f"duplicate archive entry: {name}")
                seen.add(name)
                target = temporary.joinpath(*name.parts)
                target.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
                if member.isdir():
                    target.mkdir(mode=0o755, exist_ok=True)
                    continue
                if not member.isreg():
                    raise ValueError(f"archive entry is not a regular file or directory: {name}")
                expanded += member.size
                if expanded > MAX_EXPANDED_BYTES:
                    raise ValueError("archive expands beyond 1 GiB")
                source = archive.extractfile(member)
                if source is None:
                    raise ValueError(f"cannot read archive entry: {name}")
                mode = 0o755 if member.mode & 0o111 else 0o644
                with target.open("xb") as output:
                    remaining = member.size
                    while remaining:
                        chunk = source.read(min(1024 * 1024, remaining))
                        if not chunk:
                            raise ValueError(f"truncated archive entry: {name}")
                        output.write(chunk)
                        remaining -= len(chunk)
                os.chmod(target, mode)

        required = ("Cargo.lock", "package-lock.json", "package.json", "deploy/systemd/marks.service")
        for relative in required:
            candidate = temporary / relative
            if not candidate.is_file() or candidate.is_symlink():
                raise ValueError(f"required source file is missing: {relative}")
        os.rename(temporary, final)
        print(f"uploaded {sha}: {count} entries, {expanded} expanded bytes")
    except Exception:
        remove_tree(temporary)
        raise


def main() -> None:
    if len(sys.argv) != 3 or sys.argv[1] not in ("upload", "cleanup"):
        raise SystemExit("usage: marks-upload upload|cleanup <40-char-sha>")
    sha = revision(sys.argv[2])
    if sys.argv[1] == "upload":
        upload(sha)
    else:
        remove_tree(ROOT / sha)
        print(f"cleaned {sha}")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, tarfile.TarError, OSError) as error:
        print(f"marks-upload: {error}", file=sys.stderr)
        raise SystemExit(2)
