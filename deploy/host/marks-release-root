def verify_source(source: Path, revision: str) -> None:
    if (
        source.resolve().parent != CLAIMED.resolve()
        or not source.name.startswith(f"{revision}.")
    ):
        fail("source is outside the fixed claimed root")
    for relative in ("Cargo.lock", "package-lock.json", "package.json", "deploy/systemd/marks.service"):
        candidate = source / relative
        if not candidate.is_file() or candidate.is_symlink():
            fail(f"uploaded source lacks {relative}")
    if (source / ".git").exists() or (source / ".git").is_symlink():
        fail("uploaded source must not contain Git metadata")
    env = fixed_environment()
    git_dir = VERIFIED_GIT / f"{revision}.git"
    if git_dir.exists():
        shutil.rmtree(git_dir)
    run(["/usr/bin/git", "init", "--quiet", "--bare", git_dir], env=env)
    git = ["/usr/bin/git", f"--git-dir={git_dir}", f"--work-tree={source}"]
    run([*git, "remote", "add", "origin", REMOTE], env=env)
    run(
        [
            *git,
            "-c",
            "http.lowSpeedLimit=1024",
            "-c",
            "http.lowSpeedTime=30",
            "fetch",
            "--quiet",
            "--depth=1",
            "origin",
            "refs/heads/main",
        ],
        timeout=5 * 60,
        env=env,
    )
    fetched = run(
        [*git, "rev-parse", "FETCH_HEAD"],
        capture=True,
        capture_limit=128,
        env=env,
    ).stdout.strip()
    if fetched != revision:
        fail(f"requested revision is not current remote main ({fetched})")
    run([*git, "reset", "--quiet", "--mixed", revision], env=env)
    dirty = run(
        [*git, "status", "--porcelain=v1", "--untracked-files=all"],
        capture=True,
        capture_limit=64 * 1024,
        env=env,
    ).stdout
    if dirty:
        fail("uploaded archive does not exactly match the requested Git revision")


def validate_directory_descriptor(descriptor: int, owner, label: str) -> None:
    info = os.fstat(descriptor)
    if not stat.S_ISDIR(info.st_mode):
        fail(f"{label} is not a directory")
    if (info.st_uid, info.st_gid) != owner:
        fail(f"{label} has an unexpected owner")
    if info.st_mode & 0o022:
        fail(f"{label} is writable by group or other")


def validate_built_binary_descriptor(descriptor: int, owner, name: str):
    info = os.fstat(descriptor)
    if not stat.S_ISREG(info.st_mode):
        fail(f"built {name} is not a regular file")
    if (info.st_uid, info.st_gid) != owner:
        fail(f"built {name} has an unexpected owner")
    if info.st_nlink != 1:
        fail(f"built {name} has multiple filesystem links")
    if info.st_size <= 0 or info.st_size > MAX_BUILT_BINARY_BYTES:
        fail(f"built {name} has an invalid size")
    if info.st_mode & (stat.S_IWGRP | stat.S_IWOTH | stat.S_ISUID | stat.S_ISGID):
        fail(f"built {name} has unsafe permissions")
    return info


def create_cargo_workspace(revision: str) -> Path:
    """Create empty, per-release Cargo state beneath the bounded filesystem."""
    uid, gid = build_identity()
    root_owner = (0, 0) if os.geteuid() == 0 else (os.getuid(), os.getgid())
    cargo = WORKSPACES / f".cargo-{sha(revision)}.{os.getpid()}"
    if cargo.exists() or cargo.is_symlink():
        fail("per-release Cargo workspace already exists")
    cargo.mkdir(mode=0o700)
    if os.geteuid() == 0:
        os.chown(cargo, *root_owner)
    for name in ("home", "target"):
        child = cargo / name
        child.mkdir(mode=0o700)
        if os.geteuid() == 0:
            os.chown(child, uid, gid)
    return cargo


def copy_built_binary(cargo: Path, name: str, destination: Path) -> None:
    """Import one fresh Cargo export through no-follow descriptors and hard bounds."""
    if name not in ("marks-server", "marks-admin"):
        fail("unsupported built binary name")
    uid, gid = build_identity()
    root_owner = (0, 0) if os.geteuid() == 0 else (os.getuid(), os.getgid())
    if cargo.parent != WORKSPACES or not cargo.name.startswith(".cargo-"):
        fail("Cargo output is outside the fixed per-release workspace root")
    descriptors = []
    destination_fd = None
    try:
        workspaces_fd = os.open(WORKSPACES, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        descriptors.append(workspaces_fd)
        validate_directory_descriptor(workspaces_fd, root_owner, "build workspaces root")
        cargo_fd = os.open(
            cargo.name,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
            dir_fd=workspaces_fd,
        )
        descriptors.append(cargo_fd)
        validate_directory_descriptor(cargo_fd, root_owner, "per-release Cargo root")
        target_fd = os.open(
            "target",
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
            dir_fd=cargo_fd,
        )
        descriptors.append(target_fd)
        validate_directory_descriptor(target_fd, (uid, gid), "Cargo target cache")
        export_fd = os.open(
            "marks-export",
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
            dir_fd=target_fd,
        )
        descriptors.append(export_fd)
        validate_directory_descriptor(export_fd, (uid, gid), "Cargo binary export directory")
        binary_fd = os.open(
            name,
            os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW,
            dir_fd=export_fd,
        )
        descriptors.append(binary_fd)
        before = validate_built_binary_descriptor(binary_fd, (uid, gid), name)

        destination_fd = os.open(
            destination,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o700,
        )
        copied = 0
        while copied < before.st_size:
            block = os.read(binary_fd, min(1024 * 1024, before.st_size - copied))
            if not block:
                fail(f"built {name} was truncated during import")
            remaining = memoryview(block)
            while remaining:
                written = os.write(destination_fd, remaining)
                remaining = remaining[written:]
            copied += len(block)
        if os.read(binary_fd, 1):
            fail(f"built {name} grew during import")
        after = os.fstat(binary_fd)
        fingerprint = lambda info: (
            info.st_dev,
            info.st_ino,
            info.st_size,
            info.st_mtime_ns,
            info.st_ctime_ns,
        )
        if fingerprint(before) != fingerprint(after):
            fail(f"built {name} changed during import")
        os.fchmod(destination_fd, 0o755)
        os.fsync(destination_fd)
    except OSError as error:
        destination.unlink(missing_ok=True)
        fail(f"built {name} path could not be opened safely: {error}")
    except Exception:
        destination.unlink(missing_ok=True)
        raise
    finally:
        if destination_fd is not None:
            os.close(destination_fd)
        for descriptor in reversed(descriptors):
            os.close(descriptor)


def validate_fetch_egress_policy():
    """Require the admin-attested, fixed Docker fetch network contract."""
    try:
        info = FETCH_EGRESS_POLICY.lstat()
    except OSError as error:
        fail(
            "Cargo fetch egress policy is not provisioned; see deploy/host/README.md: "
            f"{error}"
        )
    expected_owner = (0, 0) if os.geteuid() == 0 else (os.getuid(), os.getgid())
    if (
        stat.S_ISLNK(info.st_mode)
        or not stat.S_ISREG(info.st_mode)
        or info.st_nlink != 1
        or (info.st_uid, info.st_gid) != expected_owner
        or info.st_mode & 0o022
    ):
        fail("Cargo fetch egress policy receipt is unsafe")
    data = read_bounded_regular_bytes(
        FETCH_EGRESS_POLICY,
        "Cargo fetch egress policy receipt",
        1024,
    )
    if data.decode("utf-8", errors="strict") != FETCH_EGRESS_POLICY_TEXT:
        fail("Cargo fetch egress policy receipt is unsupported")
    result = run(
        [
            "/usr/bin/timeout", "--signal=KILL", "15s",
            "/usr/bin/docker", "network", "inspect",
            "--format={{json .}}", CARGO_FETCH_NETWORK,
        ],
        capture=True,
        capture_limit=64 * 1024,
        env=fixed_environment(),
    )
    try:
        network = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        fail(f"Cargo fetch network did not return bounded JSON: {error}")
    ipam = network.get("IPAM") if isinstance(network, dict) else None
    config = ipam.get("Config") if isinstance(ipam, dict) else None
    labels = network.get("Labels") if isinstance(network, dict) else None
    options = network.get("Options") if isinstance(network, dict) else None
    if (
        network.get("Name") != CARGO_FETCH_NETWORK
        or network.get("Driver") != "bridge"
        or network.get("Scope") != "local"
        or network.get("EnableIPv4") is not True
        or network.get("EnableIPv6") is not False
        or network.get("Internal") is not False
        or network.get("Attachable") is not False
        or network.get("Ingress") is not False
        or labels != {"build.marks.secure/fetch-egress-policy": "marks.fetch-egress.v1"}
        or not isinstance(options, dict)
        or options.get("com.docker.network.bridge.enable_icc") != "false"
        or not isinstance(config, list)
        or len(config) != 1
        or config[0].get("Subnet") != "172.30.0.0/24"
    ):
        fail("Cargo fetch Docker network differs from the fixed egress policy")
    return {
        "schema": "marks.fetch-egress.v1",
        "network": CARGO_FETCH_NETWORK,
        "subnet": "172.30.0.0/24",
    }


def docker_fetch(source: Path, cargo: Path, revision: str) -> None:
    validate_fetch_egress_policy()
    uid, gid = build_identity()
    container = f"marks-fetch-{revision[:12]}-{os.getpid()}"
    try:
        run([
            "/usr/bin/docker", "run", "--name", container, "--rm", "--pull=never",
            "--log-driver=none", f"--network={CARGO_FETCH_NETWORK}",
            "--read-only", "--cap-drop=ALL", "--security-opt=no-new-privileges",
            "--pids-limit=256", "--memory=2g", "--cpus=4", f"--user={uid}:{gid}",
            "--env=HOME=/tmp", "--env=CARGO_HOME=/cargo",
            "--env=RUSTUP_TOOLCHAIN=1.88.0", "--env=CARGO_NET_GIT_FETCH_WITH_CLI=false",
