def freeze_client_output(workspace: Path, output: Path) -> None:
    """Seal the only build-workspace bytes that cross into a release."""
    try:
        relative = output.relative_to(workspace)
    except ValueError:
        fail("client output escapes the hidden build workspace")
    current = workspace
    for part in relative.parts:
        current = current / part
        info = current.lstat()
        if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
            fail(f"client output path component is not a real directory: {current}")

    uid, gid = build_identity()
    entries = [output]
    total_files = 0
    total_bytes = 0
    for root, dirs, files in os.walk(output, topdown=True, followlinks=False):
        for name in dirs + files:
            item = Path(root) / name
            info = item.lstat()
            if stat.S_ISLNK(info.st_mode) or not (
                stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)
            ):
                fail(f"client output contains an unsupported object: {item.relative_to(output)}")
            if (info.st_uid, info.st_gid) != (uid, gid):
                fail(f"client output has an unexpected owner: {item.relative_to(output)}")
            entries.append(item)
            total_files += 1
            if stat.S_ISREG(info.st_mode):
                total_bytes += info.st_size
                if info.st_nlink != 1:
                    fail(f"client output file has multiple links: {item.relative_to(output)}")
            if total_files > MAX_SOURCE_FILES or total_bytes > MAX_SOURCE_BYTES:
                fail("client output exceeds release bounds")
    output_info = output.lstat()
    if (output_info.st_uid, output_info.st_gid) != (uid, gid):
        fail("client output root has an unexpected owner")
    for item in sorted(entries, key=lambda path: len(path.parts), reverse=True):
        info = item.lstat()
        if os.geteuid() == 0:
            os.chown(item, 0, 0, follow_symlinks=False)
        os.chmod(item, 0o555 if stat.S_ISDIR(info.st_mode) else 0o444)


def copy_regular_tree(source: Path, destination: Path) -> None:
    for item in source.rglob("*"):
        relative = item.relative_to(source)
        target = destination / relative
        info = item.lstat()
        if stat.S_ISLNK(info.st_mode) or not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
            fail(f"build output contains unsupported object: {relative}")
        if item.is_dir():
            target.mkdir(parents=True, exist_ok=True)
        else:
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(item, target)
            os.chmod(target, 0o644)


def seal_release(source: Path, cargo: Path, revision: str, build) -> Path:
    identifier = release_identity(revision, build["variant"], build["digest"])
    release = RELEASES / identifier
    if release.exists():
        return validate_release(release)
    stage = RELEASES / f".{identifier}.staging.{os.getpid()}"
    if stage.exists():
        shutil.rmtree(stage)
    stage.mkdir(mode=0o755)
    try:
        copy_built_binary(cargo, "marks-server", stage / "marks-server")
        copy_built_binary(cargo, "marks-admin", stage / "marks-admin")
        (stage / "static").mkdir(mode=0o755)
        copy_regular_tree(build["clientOutput"], stage / "static")
        shutil.copyfile(TEMPLATE, stage / "marks.service")
        os.chmod(stage / "marks.service", 0o644)
        schema_receipt = built_schema_receipt(stage)
        static_build_receipt = read_bounded_json_file(
            stage / "static" / "marks-product-build.json",
            "generated static product build receipt",
            MAX_BUILD_RECEIPT_BYTES,
        )
        expected_build_receipt = {
            "schema": BUILD_PLAN_RECEIPT_SCHEMA,
            "buildPlan": build["plan"],
            "buildPlanSha256": build["digest"],
        }
        if static_build_receipt != expected_build_receipt:
            fail("client output product build receipt differs from the resolved build plan")
        receipt = {
            "schema": RELEASE_SCHEMA, "revision": revision,
            "releaseId": identifier,
            "productVariant": build["variant"],
            "buildPlanSha256": build["digest"],
            "buildPlan": build["plan"],
            "features": build["plan"]["features"],
            "serverCargoFeatures": build["cargoFeatures"],
            "createdAt": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "builderImage": BUILDER_IMAGE,
            "nodeVersion": run(["/usr/bin/node", "--version"], capture=True).stdout.strip(),
            "npmVersion": run(["/usr/bin/npm", "--version"], capture=True).stdout.strip(),
            "schemaVersion": schema_receipt["schemaVersion"],
            "maxCompatibleSchema": schema_receipt["maxCompatibleSchema"],
        }
        (stage / "release.json").write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        files = sorted(item for item in stage.rglob("*") if item.is_file() and not item.is_symlink())
        manifest = "".join(f"{hash_file(item)}  {item.relative_to(stage)}\n" for item in files)
        (stage / "SHA256SUMS").write_text(manifest, encoding="utf-8")
        for item in stage.rglob("*"):
            if os.geteuid() == 0:
                os.chown(item, 0, 0)
            if item.is_dir():
                os.chmod(item, 0o755)
            elif item.name in ("marks-server", "marks-admin"):
                os.chmod(item, 0o755)
            else:
                os.chmod(item, 0o644)
        if os.geteuid() == 0:
            os.chown(stage, 0, 0)
        os.rename(stage, release)
    except Exception:
        shutil.rmtree(stage, ignore_errors=True)
        raise
    sealed = validate_release(release)
    link_release_assets(sealed)
    return sealed


def purge_private_staging(root: Path, prefix: str) -> None:
    """Remove stale transient directories from one root-only parent.

    A worker uid can mutate a directory after it is bind-mounted, but cannot
    replace its entry in this root-owned parent. Refuse surprising top-level
    objects and never follow a stale link during cleanup.
    """
    if os.geteuid() == 0:
        unit_pattern = None
        if root == SQLITE_STAGING:
            unit_pattern = "marks-sqlite-*"
        elif root == CANARY:
            unit_pattern = "marks-canary-*"
        if unit_pattern is not None:
            # A killed root client can leave a bounded transient unit alive.
            # The deploy lock means any matching unit is stale; quiesce it
            # before touching the bind-mounted directory.
            run(
                ["/usr/bin/systemctl", "stop", unit_pattern],
                check=False,
                timeout=30,
                env=fixed_environment(),
            )
            run(
                ["/usr/bin/systemctl", "reset-failed", unit_pattern],
                check=False,
                timeout=30,
                env=fixed_environment(),
            )
    if not root.is_dir() or root.is_symlink():
        fail(f"private staging root is unavailable: {root}")
    for entry in root.iterdir():
        info = entry.lstat()
        if not entry.name.startswith(prefix) or not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
            fail(f"private staging root contains an unexpected object: {entry}")
        shutil.rmtree(entry)


def service_state_directory() -> Path:
    """Validate the fixed directory entry systemd may bind as root.

    The devuser-controlled marks.db3 entry is deliberately not resolved here.
    `/var/lib/marks` itself cannot be renamed by devuser because its parent is
    root-owned; SQLite opens the mutable child only after privilege demotion.
    """
    directory = LIVE_DB.parent
    try:
        info = directory.lstat()
    except OSError as error:
        fail(f"Marks service state directory is unavailable: {error}")
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
        fail("Marks service state path is not one fixed real directory")
    uid, gid = service_identity()
    if os.geteuid() == 0 and (info.st_uid, info.st_gid) != (uid, gid):
        fail("Marks service state directory has an unexpected owner")
    return directory


def live_database_present() -> bool:
    """Check only the directory entry; never parse live SQLite as root."""
    try:
        info = LIVE_DB.lstat()
    except FileNotFoundError:
        return False
    service_state_directory()
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        fail("live database is not one regular no-follow file")
    return True


def validate_sqlite_receipt(receipt, operation: str):
    shapes = {
        "inspect": {"schema", "sourceBytes", "schemaVersion"},
        "snapshot": {
            "schema", "sourceBytes", "schemaVersion", "snapshotBytes", "sha256"
        },
        "publish": {"schema", "published", "snapshotBytes", "sha256"},
    }
    if operation not in shapes or not isinstance(receipt, dict) or set(receipt) != shapes[operation]:
        fail("SQLite worker receipt has an unexpected shape")
    if receipt.get("schema") != "marks.sqlite-worker.v1":
        fail("SQLite worker receipt schema is unsupported")
    integer_keys = shapes[operation] & {"sourceBytes", "schemaVersion", "snapshotBytes"}
    if any(type(receipt.get(key)) is not int or receipt[key] < 0 for key in integer_keys):
        fail("SQLite worker receipt contains an invalid integer")
    for key in ("sourceBytes", "snapshotBytes"):
        if key in receipt and receipt[key] > MAX_CANARY_SEED_BYTES:
            fail("SQLite worker receipt exceeds the database byte ceiling")
    if "snapshotBytes" in receipt and receipt["snapshotBytes"] <= 0:
        fail("SQLite worker returned an empty snapshot")
    if "sha256" in receipt and not SHA256_RE.fullmatch(str(receipt["sha256"])):
        fail("SQLite worker receipt digest is invalid")
    if "published" in receipt and not BACKUP_NAME_RE.fullmatch(str(receipt["published"])):
        fail("SQLite worker publication identity is invalid")
    return receipt


def run_sqlite_worker(operation: str, *, stage=None, publication=None):
    """Run the installed SQLite parser only as the service uid in a sandbox."""
    if operation not in ("inspect", "snapshot", "publish"):
        fail("unsupported SQLite worker operation")
    service_root = service_state_directory()
    uid, gid = service_identity()
    payload = [SQLITE_WORKER, operation]
    if operation == "publish":
        if publication is None:
            fail("SQLite publication name is required")
        payload.append(publication)
    elif publication is not None:
        fail("unexpected SQLite publication name")

    if os.geteuid() != 0:
        # Fixture tests patch this boundary or exercise marks-sqlite-worker
        # directly. This direct branch never carries elevated authority.
        output = run(
            payload,
            capture=True,
            capture_limit=MAX_SQLITE_RECEIPT_BYTES,
            env=fixed_environment(),
        ).stdout
    else:
        path_token = hashlib.sha256(
            f"{operation}:{stage}:{os.getpid()}".encode("utf-8")
        ).hexdigest()[:12]
        command = [
            "/usr/bin/systemd-run", "--quiet", "--wait", "--pipe", "--collect",
            f"--unit=marks-sqlite-{operation}-{path_token}",
            f"--uid={uid}", f"--gid={gid}", "--property=Type=exec",
            f"--property=RuntimeMaxSec={SQLITE_WORKER_RUNTIME_SECONDS}",
            "--property=MemoryMax=768M", "--property=TasksMax=32",
            "--property=CPUQuota=200%", "--property=LimitFSIZE=536870912",
            "--property=KillMode=mixed", "--property=TimeoutStopSec=10",
            "--property=ProtectSystem=strict", "--property=ProtectHome=yes",
            "--property=PrivateTmp=yes", "--property=PrivateDevices=yes",
            "--property=PrivateNetwork=yes", "--property=NoNewPrivileges=yes",
            "--property=RestrictSUIDSGID=yes", "--property=CapabilityBoundingSet=",
            "--property=RestrictRealtime=yes", "--property=LockPersonality=yes",
            "--property=ProtectKernelTunables=yes", "--property=ProtectKernelModules=yes",
            "--property=ProtectControlGroups=yes", "--property=RestrictAddressFamilies=AF_UNIX",
            "--property=TemporaryFileSystem=/tmp:rw,nodev,nosuid,noexec,size=64M",
            "--property=InaccessiblePaths=/home /root /etc/marks /run/docker.sock",
            "--setenv=HOME=/tmp", "--setenv=LANG=C.UTF-8", "--setenv=LC_ALL=C.UTF-8",
        ]
        if operation == "publish":
            if stage is None:
                fail("SQLite publication stage is required")
            command.extend([
                f"--property=BindReadOnlyPaths={stage}:/marks-input",
                # Bind the fixed service-state directory, not its mutable
                # backup child. Path resolution is safe, and all writes occur
                # only after the worker is devuser.
                f"--property=BindPaths={service_root}:/marks-live",
            ])
        else:
            command.append(f"--property=BindReadOnlyPaths={service_root}:/marks-live")
            if operation == "snapshot":
                if stage is None:
                    fail("SQLite snapshot stage is required")
                command.append(f"--property=BindPaths={stage}:/marks-output")
        command.extend(str(item) for item in payload)
        output = run(
            command,
            capture=True,
            capture_limit=MAX_SQLITE_RECEIPT_BYTES,
        ).stdout
    try:
        receipt = json.loads(output.strip())
    except json.JSONDecodeError as error:
        fail(f"SQLite worker did not return bounded JSON: {error}")
    return validate_sqlite_receipt(receipt, operation)


def descriptor_sha256(descriptor: int, maximum: int) -> str:
    digest = hashlib.sha256()
    total = 0
    os.lseek(descriptor, 0, os.SEEK_SET)
    while True:
        block = os.read(descriptor, min(1024 * 1024, maximum + 1 - total))
        if not block:
            break
        total += len(block)
        if total > maximum:
            fail("SQLite snapshot exceeds its descriptor read bound")
        digest.update(block)
    return digest.hexdigest()


def create_sqlite_snapshot():
    """Create and descriptor-verify one bounded devuser SQLite snapshot."""
    if not live_database_present():
        return None
    purge_private_staging(SQLITE_STAGING, "snapshot-")
    stage = Path(tempfile.mkdtemp(prefix="snapshot-", dir=SQLITE_STAGING))
    uid, gid = service_identity()
    if os.geteuid() == 0:
        os.chown(stage, uid, gid)
    os.chmod(stage, 0o700)
    try:
        receipt = run_sqlite_worker("snapshot", stage=stage)
        snapshot = stage / "snapshot.db3"
        descriptor = os.open(snapshot, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            before = os.fstat(descriptor)
            if (
                not stat.S_ISREG(before.st_mode)
                or before.st_nlink != 1
                or (before.st_uid, before.st_gid) != (uid, gid)
                or before.st_size != receipt["snapshotBytes"]
                or before.st_size <= 0
                or before.st_size > MAX_CANARY_SEED_BYTES
            ):
                fail("SQLite worker snapshot failed descriptor validation")
            digest = descriptor_sha256(descriptor, MAX_CANARY_SEED_BYTES)
            after = os.fstat(descriptor)
            fingerprint = lambda value: (
                value.st_dev, value.st_ino, value.st_size,
                value.st_mtime_ns, value.st_ctime_ns,
            )
            if fingerprint(before) != fingerprint(after) or digest != receipt["sha256"]:
                fail("SQLite worker snapshot changed or differs from its receipt")
        finally:
            os.close(descriptor)
        return stage, snapshot, receipt
    except Exception:
        shutil.rmtree(stage, ignore_errors=True)
        raise


def prune_authoritative_snapshots(*, reserve=0) -> None:
    """Keep root-owned activation snapshots below a fixed count/byte bound."""
    if reserve not in (0, 1):
        fail("authoritative snapshot reserve is invalid")
    for entry in list(SQLITE_ARCHIVE.iterdir()):
        info = entry.lstat()
        if re.fullmatch(
            r"\.pre-activation-[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9._-]{1,64}\.db3"
            r"\.tmp\.[0-9]+\.[0-9a-f]{32}",
            entry.name,
        ):
            if (
                stat.S_ISLNK(info.st_mode)
                or not stat.S_ISREG(info.st_mode)
                or info.st_nlink not in (1, 2)
                or (os.geteuid() == 0 and (info.st_uid, info.st_gid) != (0, 0))
                or info.st_size < 0
                or info.st_size > MAX_CANARY_SEED_BYTES
            ):
                fail(f"authoritative snapshot archive contains an unsafe temporary: {entry}")
            entry.unlink()
    entries = []
    # Normalize stale hard-link publications before examining final files.
    # This is deliberately a second scan: directory iteration order must not
    # make a post-link crash's nlink=2 final look corrupt.
    for entry in SQLITE_ARCHIVE.iterdir():
        info = entry.lstat()
        if (
            not BACKUP_NAME_RE.fullmatch(entry.name)
            or stat.S_ISLNK(info.st_mode)
            or not stat.S_ISREG(info.st_mode)
            or info.st_nlink != 1
            or (os.geteuid() == 0 and (info.st_uid, info.st_gid) != (0, 0))
            or info.st_size <= 0
            or info.st_size > MAX_CANARY_SEED_BYTES
        ):
            fail(f"authoritative snapshot archive contains an unsafe object: {entry}")
        entries.append((entry.name, entry, info.st_size))
    entries.sort(reverse=True)
    keep = KEEP_AUTHORITATIVE_SNAPSHOTS - reserve
    for _name, entry, _size in entries[keep:]:
        entry.unlink()
    retained = entries[:keep]
    if sum(size for _name, _entry, size in retained) > keep * MAX_CANARY_SEED_BYTES:
        fail("authoritative snapshot archive exceeds its aggregate bound")


def archive_sqlite_snapshot(snapshot: Path, receipt, name: str) -> Path:
    """Import worker output as a root-owned, bounded recovery snapshot."""
    if not BACKUP_NAME_RE.fullmatch(name):
        fail("authoritative snapshot name is invalid")
    try:
        (SQLITE_ARCHIVE / name).lstat()
    except FileNotFoundError:
        pass
    else:
        raise FileExistsError(f"authoritative snapshot already exists: {name}")
    prune_authoritative_snapshots(reserve=1)
    uid, gid = service_identity()
    source_fd = os.open(snapshot, os.O_RDONLY | os.O_NOFOLLOW)
    directory_fd = os.open(
        SQLITE_ARCHIVE, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    )
    destination_fd = None
    temporary_created = False
    destination = SQLITE_ARCHIVE / name
    temporary_name = f".{name}.tmp.{os.getpid()}.{secrets.token_hex(16)}"
    try:
        before = os.fstat(source_fd)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or (before.st_uid, before.st_gid) != (uid, gid)
            or before.st_size != receipt["snapshotBytes"]
            or before.st_size <= 0
            or before.st_size > MAX_CANARY_SEED_BYTES
        ):
            fail("SQLite snapshot is unsafe for authoritative import")
        destination_fd = os.open(
            temporary_name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o400,
            dir_fd=directory_fd,
        )
        temporary_created = True
        copied = 0
        digest = hashlib.sha256()
        while copied < before.st_size:
            block = os.read(source_fd, min(1024 * 1024, before.st_size - copied))
            if not block:
                fail("SQLite snapshot was truncated during authoritative import")
            remaining = memoryview(block)
            while remaining:
                written = os.write(destination_fd, remaining)
                remaining = remaining[written:]
            copied += len(block)
            digest.update(block)
        if os.read(source_fd, 1):
            fail("SQLite snapshot grew during authoritative import")
        after = os.fstat(source_fd)
        fingerprint = lambda value: (
            value.st_dev, value.st_ino, value.st_size,
            value.st_mtime_ns, value.st_ctime_ns,
        )
        if fingerprint(before) != fingerprint(after) or digest.hexdigest() != receipt["sha256"]:
            fail("SQLite snapshot changed or differs from its authoritative receipt")
        if os.geteuid() == 0:
            os.fchown(destination_fd, 0, 0)
        os.fchmod(destination_fd, 0o400)
        os.fsync(destination_fd)
        os.close(destination_fd)
        destination_fd = None
        # Hard-link publication is atomic and fails if the final name already
        # exists. Removing the hidden link leaves a complete nlink=1 archive.
        os.link(
            temporary_name,
            name,
            src_dir_fd=directory_fd,
            dst_dir_fd=directory_fd,
            follow_symlinks=False,
        )
        os.unlink(temporary_name, dir_fd=directory_fd)
        os.fsync(directory_fd)
        return destination
    except Exception:
        if temporary_created:
            try:
                os.unlink(temporary_name, dir_fd=directory_fd)
            except FileNotFoundError:
                pass
        raise
    finally:
        if destination_fd is not None:
            os.close(destination_fd)
        os.close(directory_fd)
        os.close(source_fd)


def publish_sqlite_snapshot(stage: Path, receipt, name: str) -> None:
    published = run_sqlite_worker("publish", stage=stage, publication=name)
    if (
        published["published"] != name
        or published["snapshotBytes"] != receipt["snapshotBytes"]
        or published["sha256"] != receipt["sha256"]
    ):
        fail("published backup receipt differs from the verified snapshot")


def purge_canary_state() -> None:
    # This removes host-disk state left by pre-tmpfs versions or a killed
    # helper. New canaries never write beneath CANARY.
    purge_private_staging(CANARY, "")


def canary_url_json(canary_unit: str, url: str, timeout: float):
    """Fetch a bounded receipt from inside the candidate's network namespace."""
    parsed = urllib.parse.urlsplit(url)
    if (
        parsed.scheme != "http"
        or parsed.hostname != "127.0.0.1"
        or parsed.username is not None
        or parsed.password is not None
        or parsed.fragment
        or parsed.port is None
    ):
        fail("canary probe URL is outside the fixed private loopback origin")
    if timeout <= 0:
        fail("canary probe deadline has elapsed")
    probe_unit = f"marks-canary-probe-{secrets.token_hex(8)}"
    runtime = max(1, min(6, int(timeout) + 1))
    result = run(
        [
            "/usr/bin/systemd-run",
            "--quiet",
            "--wait",
            "--pipe",
            "--collect",
            f"--unit={probe_unit}",
            "--property=Type=exec",
            f"--property=JoinsNamespaceOf={canary_unit}.service",
            "--property=PrivateNetwork=yes",
            "--property=DynamicUser=yes",
            f"--property=RuntimeMaxSec={runtime}",
            "--property=MemoryMax=64M",
            "--property=TasksMax=16",
            "--property=CPUQuota=100%",
            "--property=ProtectSystem=strict",
            "--property=ProtectHome=yes",
            "--property=PrivateTmp=yes",
            "--property=PrivateDevices=yes",
            "--property=NoNewPrivileges=yes",
            "--property=CapabilityBoundingSet=",
            "--property=ProtectProc=invisible",
            "--property=ProcSubset=pid",
            "--property=RestrictSUIDSGID=yes",
            "--property=RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6",
            "/usr/bin/curl",
            "--disable",
            "--fail",
            "--silent",
            "--show-error",
            "--max-time",
            f"{max(0.001, float(timeout)):.3f}",
            "--max-filesize",
            str(MAX_HTTP_JSON_BYTES),
            "--header",
            "Accept: application/json",
            url,
        ],
        capture=True,
        capture_limit=MAX_HTTP_JSON_BYTES,
        env=fixed_environment(),
    )
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        fail(f"private canary probe did not return bounded JSON: {error}")


def canary(release: Path, receipt, seed_snapshot=None) -> None:
    # The candidate must never share the live service uid: same-uid processes
    # can signal and inspect one another despite path isolation. DynamicUser
    # gives every canary a distinct ephemeral identity.
    revision = receipt["revision"]
    with socket.socket() as listener:
        listener.bind(("127.0.0.1", 0))
        port = listener.getsockname()[1]
    purge_canary_state()
    unit = f"marks-canary-{revision[:12]}-{os.getpid()}"
    seed_binding = []
    if seed_snapshot is not None:
        seed_binding = [f"--property=BindReadOnlyPaths={seed_snapshot}:/marks-seed.db3"]
    try:
        run([
            "/usr/bin/systemd-run", "--quiet", "--collect", f"--unit={unit}",
            "--property=DynamicUser=yes",
            "--property=Type=exec", "--property=ProtectSystem=strict", "--property=ProtectHome=yes",
            f"--property=RuntimeMaxSec={CANARY_RUNTIME_SECONDS}",
            "--property=MemoryHigh=2G", "--property=MemoryMax=3G",
            "--property=TasksMax=512", "--property=CPUQuota=400%",
            "--property=KillMode=mixed", "--property=TimeoutStopSec=15",
            "--property=LimitFSIZE=1073741824",
            "--property=StandardOutput=null", "--property=StandardError=null",
            "--property=PrivateTmp=yes", "--property=PrivateDevices=yes", "--property=NoNewPrivileges=yes",
            "--property=CapabilityBoundingSet=", "--property=RestrictSUIDSGID=yes",
            "--property=PrivateNetwork=yes",
            "--property=ProtectProc=invisible", "--property=ProcSubset=pid",
            "--property=RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6",
            "--property=InaccessiblePaths=/var/lib/marks /etc/marks /home /root /run/docker.sock",
            f"--property=BindReadOnlyPaths={release}:/marks-release",
            f"--property=TemporaryFileSystem=/marks-canary:rw,nodev,nosuid,noexec,size={CANARY_TMPFS_BYTES},mode=1777",
            "--property=TemporaryFileSystem=/tmp:rw,nodev,nosuid,noexec,size=64M",
            *seed_binding,
            f"--setenv=MARKS_LISTEN=127.0.0.1:{port}",
            f"--setenv=MARKS_ORIGIN=http://127.0.0.1:{port}", "--setenv=MARKS_DB=/marks-canary/marks.db3",
            "--setenv=MARKS_ASSET_DIR=/marks-canary/assets", "--setenv=MARKS_BACKUP_DIR=/marks-canary/backups",
            "--setenv=MARKS_STATIC_DIR=/marks-release/static", "--setenv=RUST_LOG=info",
            SQLITE_WORKER, "launch-canary",
        ])
        wait_ready(
            f"http://127.0.0.1:{port}",
            revision,
            build_plan=receipt.get("buildPlan"),
            fetch_json=lambda url, timeout: canary_url_json(unit, url, timeout),
        )
    finally:
        run(["/usr/bin/systemctl", "stop", unit], check=False)
        run(["/usr/bin/systemctl", "reset-failed", unit], check=False)


def backup_live_database(reason: str) -> None:
    """A verified pre-activation snapshot taken by the outgoing release,
    before the new binary can touch the schema."""
    snapshot = create_sqlite_snapshot()
    if snapshot is None:
        print("no live database yet; skipping pre-activation backup")
        return
    stage, _snapshot_path, receipt = snapshot
    try:
        stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        name = f"pre-activation-{stamp}-{reason}-{os.getpid()}.db3"
        authoritative = archive_sqlite_snapshot(_snapshot_path, receipt, name)
        publish_sqlite_snapshot(stage, receipt, name)
        print(
            f"pre-activation backup verified: {authoritative} "
            f"service-copy={BACKUPS / name} "
            f"sha256={receipt['sha256']}"
        )
    finally:
        shutil.rmtree(stage, ignore_errors=True)


def preflight_rollback(target: Path, receipt) -> None:
    """Refuse a rollback the target binary cannot survive, then prove it.

    The declared compatibility range fails fast on an intentional schema
    break; the seeded canary is the empirical proof — the candidate binary
    must boot and report ready against a copy of the live database before
    the real switch happens.
    """
    if receipt.get("legacy"):
        return
    snapshot = create_sqlite_snapshot()
    if snapshot is None:
        canary(target, receipt)
        return
    stage, snapshot_path, snapshot_receipt = snapshot
    try:
        live = snapshot_receipt["schemaVersion"]
        declared = receipt.get("maxCompatibleSchema")
        if isinstance(declared, int) and live > declared:
            fail(
                f"live database schema v{live} exceeds the target binary's "
                f"supported v{declared}; roll forward instead"
            )
        canary(target, receipt, seed_snapshot=snapshot_path)
    finally:
        shutil.rmtree(stage, ignore_errors=True)


def require_target_product_variant(receipt) -> None:
    """Never activate an explicit v2 artifact for another target."""
    if (
        receipt.get("schema") == RELEASE_SCHEMA
        and receipt.get("productVariant") != TARGET_PRODUCT_VARIANT
    ):
        fail(
            f"this deployment target activates only {TARGET_PRODUCT_VARIANT} releases"
        )


def require_normal_rollback_receipt(receipt) -> None:
    """Normal remote rollback is only for receipt-bound stable artifacts.

    Revision-only v1 and captured legacy releases cannot prove their compiled
    feature plan. They remain recoverable only through the explicit local-root
    break-glass operation below, never through the deployment SSH credential.
    """
    if receipt.get("schema") != RELEASE_SCHEMA:
        fail(
            "normal rollback requires a v2 stable product-build receipt; "
            "legacy recovery is local-root break-glass only"
        )
    require_target_product_variant(receipt)


def require_local_break_glass() -> None:
    """Keep unknown-plan recovery outside the restricted SSH trust boundary."""
    if (
        os.geteuid() != 0
        or os.environ.get("SUDO_USER") == "marks-deploy"
        or os.environ.get("SSH_ORIGINAL_COMMAND")
        or os.environ.get("SSH_CONNECTION")
    ):
        fail("legacy rollback is available only from a local administrator root session")


def release_pool_assets(release: Path):
    assets = release / "static" / "assets"
    if not assets.is_dir():
        return []
    return [item for item in sorted(assets.iterdir()) if item.is_file() and not item.is_symlink()]


def link_release_assets(release: Path) -> None:
    ASSET_POOL.mkdir(parents=True, exist_ok=True)
    for item in release_pool_assets(release):
        target = ASSET_POOL / item.name
        if not target.exists():
            os.link(item, target)


def purge_stale_build_state() -> None:
    """Remove every abandoned per-release workspace while holding the lock."""
    workspace_name = re.compile(r"(?:[0-9a-f]{40}\.[0-9]+|\.cargo-[0-9a-f]{40}\.[0-9]+)")
    workspace_entries = list(WORKSPACES.iterdir())
    if os.geteuid() == 0:
        identities = set()
        for entry in workspace_entries:
            matched = re.fullmatch(
                r"(?:\.cargo-)?([0-9a-f]{40})\.([0-9]+)", entry.name
            )
            if matched:
                identities.add((matched.group(1), matched.group(2)))
        for revision, process_id in identities:
            for step in ("ci", "fetch", "rebuild", "verify", "web", "budget"):
                unit = f"marks-build-{step}-{revision[:12]}-{process_id}"
                run(
                    ["/usr/bin/systemctl", "stop", unit],
                    check=False,
                    timeout=30,
                    env=fixed_environment(),
                )
                run(
                    ["/usr/bin/systemctl", "reset-failed", unit],
                    check=False,
                    timeout=30,
                    env=fixed_environment(),
                )
            run(
                [
                    "/usr/bin/docker", "rm", "--force",
                    f"marks-build-{revision[:12]}-{process_id}",
                ],
                check=False,
                timeout=30,
                env=fixed_environment(),
            )
            run(
                [
                    "/usr/bin/docker", "rm", "--force",
                    f"marks-fetch-{revision[:12]}-{process_id}",
                ],
                check=False,
                timeout=30,
                env=fixed_environment(),
            )
    for entry in workspace_entries:
        info = entry.lstat()
        if (
            not workspace_name.fullmatch(entry.name)
            or not stat.S_ISDIR(info.st_mode)
            or stat.S_ISLNK(info.st_mode)
        ):
            fail(f"build workspaces contain an unexpected object: {entry}")
        shutil.rmtree(entry)
    for entry in VERIFIED_GIT.iterdir():
        info = entry.lstat()
        if (
            not re.fullmatch(r"[0-9a-f]{40}\.git", entry.name)
            or not stat.S_ISDIR(info.st_mode)
            or stat.S_ISLNK(info.st_mode)
        ):
            fail(f"verified Git storage contains an unexpected object: {entry}")
        shutil.rmtree(entry)

    # Retire every object from the previous repository-writable cache, not
    # merely the four historical names. The root-owned parent prevents new
    # top-level races; take ownership of directories before safe rmtree and
    # unlink every other object without following it.
    for entry in list(CACHE.iterdir()):
        info = entry.lstat()
        if stat.S_ISDIR(info.st_mode) and not stat.S_ISLNK(info.st_mode):
            descriptor = os.open(
                entry, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
            )
            try:
                if os.geteuid() == 0:
                    os.fchown(descriptor, 0, 0)
                os.fchmod(descriptor, 0o700)
            finally:
                os.close(descriptor)
            shutil.rmtree(entry)
        else:
            entry.unlink()


def purge_stale_release_staging() -> None:
    """Remove only recognized root-owned release stages under the deploy lock.

    A killed root helper can leave a complete candidate beneath RELEASES,
    which intentionally lives outside the disposable build filesystem. Stop
    any abandoned schema sandbox first, reject every unexpected hidden object,
    and remove exact v1/v2/legacy stage names without following links.
    """
    if os.geteuid() == 0:
        run(
            ["/usr/bin/systemctl", "stop", "marks-schema-*"],
            check=False,
            timeout=30,
            env=fixed_environment(),
        )
        run(
            ["/usr/bin/systemctl", "reset-failed", "marks-schema-*"],
            check=False,
            timeout=30,
            env=fixed_environment(),
        )
    staging = re.compile(rf"\.({RELEASE_RE.pattern})\.staging\.[0-9]+")
    for entry in list(RELEASES.iterdir()):
        if not entry.name.startswith("."):
            continue
        info = entry.lstat()
        if (
            not staging.fullmatch(entry.name)
            or stat.S_ISLNK(info.st_mode)
            or not stat.S_ISDIR(info.st_mode)
            or info.st_nlink < 2
            or (os.geteuid() == 0 and (info.st_uid, info.st_gid) != (0, 0))
            or info.st_mode & 0o022
        ):
            fail(f"release storage contains an unsafe hidden object: {entry}")
        shutil.rmtree(entry)


def prune_releases() -> None:
    """Bounded retention plus shared-pool garbage collection.

    Keep the newest releases, everything reachable through current and
    previous, and every legacy snapshot. The asset pool then holds exactly
    the union of the retained releases' hashed assets: an asset leaves the
    pool only when no retained release references it, so an old open tab
    keeps resolving its lazy chunks for as long as its release is retained.
    """
    if not RELEASES.is_dir():
        return
    current = link_target(CURRENT)
    previous = link_target(PREVIOUS)
    protected = {release for release in (current, previous) if release}
    releases = sorted(
        (item for item in RELEASES.iterdir() if item.is_dir() and not item.name.startswith(".")),
        key=lambda item: item.stat().st_mtime,
        reverse=True,
    )
    keep = set()
    for release in releases:
        resolved = release.resolve()
        if resolved in protected or release.name.startswith("legacy-") or len(keep) < KEEP_RELEASES:
            keep.add(resolved)
    for release in releases:
        if release.resolve() not in keep:
            print(f"pruning retained release {release.name}")
            shutil.rmtree(release)
    referenced = {}
    for release in releases:
        if release.resolve() in keep:
            for item in release_pool_assets(release):
                referenced.setdefault(item.name, item)
    ASSET_POOL.mkdir(parents=True, exist_ok=True)
    for name, item in referenced.items():
        target = ASSET_POOL / name
        if not target.exists():
            os.link(item, target)
    for entry in sorted(ASSET_POOL.iterdir()):
        if entry.is_file() and entry.name not in referenced:
            print(f"garbage-collecting unreferenced pooled asset {entry.name}")
            entry.unlink()


def snapshot_legacy() -> Path:
    current = link_target(CURRENT)
    if current:
        return validate_release(current, require_current_template=False)
    binary = MARKS_ROOT / "marks-server"
    static_root = MARKS_ROOT / "static"
    if not binary.is_file() or not (static_root / "index.html").is_file():
        fail("no current release or legacy direct installation exists")
    identifier = datetime.datetime.now(datetime.timezone.utc).strftime("legacy-%Y%m%dT%H%M%SZ")
    release = RELEASES / identifier
    stage = RELEASES / f".{identifier}.staging.{os.getpid()}"
    stage.mkdir(mode=0o755)
    shutil.copyfile(binary, stage / "marks-server")
    os.chmod(stage / "marks-server", 0o755)
    # The current legacy binary has no admin companion; use the server binary only
    # for receipt completeness and never invoke it as marks-admin.
    shutil.copyfile(binary, stage / "marks-admin")
    os.chmod(stage / "marks-admin", 0o755)
    (stage / "static").mkdir()
    copy_regular_tree(static_root, stage / "static")
    shutil.copyfile(TEMPLATE, stage / "marks.service")
    receipt = {"schema": "marks-release.v1", "revision": "0" * 40, "legacy": True,
               "createdAt": datetime.datetime.now(datetime.timezone.utc).isoformat()}
    (stage / "release.json").write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n")
    files = sorted(item for item in stage.rglob("*") if item.is_file())
    (stage / "SHA256SUMS").write_text("".join(f"{hash_file(item)}  {item.relative_to(stage)}\n" for item in files))
    for item in stage.rglob("*"):
        if os.geteuid() == 0:
            os.chown(item, 0, 0)
        os.chmod(item, 0o755 if item.is_dir() or item.name in ("marks-server", "marks-admin") else 0o644)
    if os.geteuid() == 0:
        os.chown(stage, 0, 0)
    os.rename(stage, release)
    atomic_link(release, CURRENT)
    return validate_release(release)


def service_state():
    output = run(["/usr/bin/systemctl", "show", SERVICE, "-p", "ActiveState", "-p", "SubState", "-p", "MainPID", "-p", "NRestarts"], capture=True).stdout
    return output.strip()


def install_stable_unit() -> None:
    shutil.copyfile(TEMPLATE, UNIT)
    os.chown(UNIT, 0, 0)
    os.chmod(UNIT, 0o644)
    run(["/usr/bin/systemd-analyze", "verify", UNIT])
    run(["/usr/bin/systemctl", "daemon-reload"])


def activate(target: Path, *, observe: bool, historical_unit_ok=False) -> None:
    target = validate_release(target, require_current_template=not historical_unit_ok)
    target_receipt = json.loads((target / "release.json").read_text(encoding="utf-8"))
    require_target_product_variant(target_receipt)
    old = link_target(CURRENT)
    if old == target:
        receipt = target_receipt
        wait_ready(
            PUBLIC_ORIGIN,
            receipt["revision"],
            legacy=bool(receipt.get("legacy")),
            build_plan=receipt.get("buildPlan"),
        )
        return
    backup_live_database(target.name[:12])
    run(["/usr/bin/systemctl", "stop", SERVICE])
    try:
        atomic_link(target, CURRENT)
        install_stable_unit()
        run(["/usr/bin/systemctl", "start", SERVICE])
        receipt = target_receipt
        wait_ready(
            LOCAL_ORIGIN,
            receipt["revision"],
            legacy=bool(receipt.get("legacy")),
            build_plan=receipt.get("buildPlan"),
        )
        wait_ready(
            PUBLIC_ORIGIN,
            receipt["revision"],
            legacy=bool(receipt.get("legacy")),
            build_plan=receipt.get("buildPlan"),
        )
        if observe:
            baseline = run(["/usr/bin/systemctl", "show", SERVICE, "-p", "NRestarts", "--value"], capture=True).stdout.strip()
            deadline = time.monotonic() + 30
            while time.monotonic() < deadline:
                now = run(["/usr/bin/systemctl", "show", SERVICE, "-p", "NRestarts", "--value"], capture=True).stdout.strip()
                if now != baseline or run(["/usr/bin/systemctl", "is-active", SERVICE], check=False).returncode:
                    fail("marks.service restarted or became inactive during observation")
                time.sleep(2)
    except Exception:
        run(["/usr/bin/journalctl", "-u", SERVICE, "-n", "100", "--no-pager"], check=False)
        run(["/usr/bin/systemctl", "stop", SERVICE], check=False)
        if old:
            atomic_link(old, CURRENT)
            install_stable_unit()
            run(["/usr/bin/systemctl", "start", SERVICE])
            old_receipt = json.loads((old / "release.json").read_text())
            wait_ready(
                LOCAL_ORIGIN,
                old_receipt["revision"],
                legacy=bool(old_receipt.get("legacy")),
                build_plan=old_receipt.get("buildPlan"),
            )
        raise
    if old and old != target:
        atomic_link(old, PREVIOUS)


def build_deploy(revision: str, requested_variant: str, expected_digest: str) -> None:
    ensure_layout()
    if requested_variant != TARGET_PRODUCT_VARIANT:
        fail(
            f"this deployment target is fixed to {TARGET_PRODUCT_VARIANT}; "
            "provision a separate target before deploying another product variant"
        )
    # A prior deploy may have been killed after atomically publishing its
    # candidate but before activation/pruning. Bound visible releases and the
    # shared asset pool before creating at most one new candidate this run.
    prune_releases()
    purge_stale_build_state()
    purge_stale_claims()
    source = claim_uploaded_source(revision)
    git_dir = VERIFIED_GIT / f"{revision}.git"
    try:
        freeze_claimed_source(source)
        build_and_activate(source, git_dir, revision, requested_variant, expected_digest)
    finally:
        # The uploader-visible name was atomically removed before verification.
        # Cleanup addresses only this unique root claim; a concurrent upload or
        # cleanup of INCOMING/<revision> can never mutate or remove the build.
        shutil.rmtree(source, ignore_errors=True)
        shutil.rmtree(git_dir, ignore_errors=True)


def build_and_activate(
    source: Path,
    git_dir: Path,
    revision: str,
    requested_variant: str,
    expected_digest: str,
) -> None:
    verify_source(source, revision)
    # A repository unit change must not pass CI and deploy while production
    # silently keeps the older root-owned template. Require exact equality;
    # re-provision the template first, then deploy the matching revision.
    if (source / "deploy/systemd/marks.service").read_bytes() != TEMPLATE.read_bytes():
        fail("uploaded deploy/systemd/marks.service differs from the root-owned service template")
    build = resolve_build_plan(source, requested_variant, expected_digest)
    validate_node_dependency_policy(source)
    validate_cargo_dependency_policy(source)
    client_relative = build["clientOutput"].relative_to(source)
    workspace = copy_claimed_workspace(source, revision)
    cargo = None
    try:
        cargo = create_cargo_workspace(revision)
        verify_workspace_source(workspace, git_dir)
        # Only exact lockfile materialization receives public network access,
        # and lifecycle scripts are disabled there. Every dependency and
        # repository script executes later inside a private network namespace.
        sandboxed_npm(
            workspace,
            "fetch",
            "ci",
            "--ignore-scripts",
            "--no-audit",
            "--no-fund",
            allow_network=True,
        )
        sandboxed_npm(workspace, "rebuild", "rebuild")
        sandboxed_npm(workspace, "verify", "run", "verify:esbt")
        build["clientOutput"] = workspace / client_relative
        sandbox_output = Path("/work") / client_relative
        sandboxed_npm(
            workspace,
            "web",
            "run",
            "build:variant",
            "--",
            "--variant",
            build["variant"],
            "--data-mode",
            "service",
            "--out-dir",
            str(sandbox_output),
            "--require-deployable",
        )
        sandboxed_npm(
            workspace,
            "budget",
            "run",
            "check:ui-budgets",
            "--",
            "--dist-dir",
            str(sandbox_output),
        )
        verify_workspace_source(workspace, git_dir)
        freeze_client_output(workspace, build["clientOutput"])
        # Server compilation never consumes the writable npm workspace.
        docker_fetch(source, cargo, revision)
        docker_build(source, cargo, revision, build)
        release = seal_release(source, cargo, revision, build)
        receipt = json.loads((release / "release.json").read_text(encoding="utf-8"))
        canary(release, receipt)
        snapshot_legacy()
        activate(release, observe=True)
        prune_releases()
    finally:
        shutil.rmtree(workspace, ignore_errors=True)
        if cargo is not None:
            shutil.rmtree(cargo, ignore_errors=True)


def rollback(requested=None, *, allow_legacy=False) -> None:
    # Rollback remains available if the disposable build filesystem is offline.
    ensure_layout(require_build=False)
    target = RELEASES / release_id(requested) if requested else link_target(PREVIOUS)
    if target is None:
        fail("no previous release exists")
    target = validate_release(target, require_current_template=False)
    receipt = json.loads((target / "release.json").read_text(encoding="utf-8"))
    if allow_legacy:
        if receipt.get("schema") == RELEASE_SCHEMA:
            fail("local legacy break-glass accepts only legacy or v1 releases")
    else:
        require_normal_rollback_receipt(receipt)
    preflight_rollback(target, receipt)
    activate(target, observe=False, historical_unit_ok=True)


def status_command() -> None:
    current = link_target(CURRENT)
    previous = link_target(PREVIOUS)
    if current:
        label = current.name
    elif (MARKS_ROOT / "marks-server").is_file():
        label = "legacy-direct (not yet rollback-managed)"
    else:
        label = ""
    print(f"current:  {label}")
    print(f"previous: {previous.name if previous else ''}")
    print(service_state())
    if current and (current / "release.json").is_file():
        receipt = json.loads((current / "release.json").read_text(encoding="utf-8"))
        print(f"revision: {receipt.get('revision', '')}")
        print(f"product-variant: {receipt.get('productVariant', '')}")
        print(f"build-plan-sha256: {receipt.get('buildPlanSha256', '')}")
        print(json.dumps(receipt, indent=2, sort_keys=True))


def releases_command() -> None:
    current = link_target(CURRENT)
    previous = link_target(PREVIOUS)
    if not RELEASES.is_dir():
        return
    for item in sorted(RELEASES.iterdir()):
        if not item.is_dir() or item.name.startswith("."):
            continue
        markers = []
        if current == item.resolve(): markers.append("current")
        if previous == item.resolve(): markers.append("previous")
        print(item.name + ((" " + " ".join(markers)) if markers else ""))


def probe() -> None:
    commands = (
        "docker", "npm", "node", "git", "curl", "python3", "sha256sum",
        "systemd-run", "timeout", "prlimit",
    )
    build_capacity = validate_build_filesystem()
    fetch_egress = validate_fetch_egress_policy()
    build_uid, build_gid = build_identity()
    for required in (Path("/usr/bin/timeout"), Path("/usr/bin/prlimit")):
        try:
            info = required.lstat()
        except OSError as error:
            fail(f"required upload boundary executable is unavailable: {required}: {error}")
        if (
            stat.S_ISLNK(info.st_mode)
            or not stat.S_ISREG(info.st_mode)
            or (info.st_uid, info.st_gid) != (0, 0)
            or info.st_mode & 0o022
            or not info.st_mode & stat.S_IXUSR
        ):
            fail(f"required upload boundary executable is unsafe: {required}")
    value = {
        "protocol": "marks-deploy.v2", "host": socket.gethostname(), "architecture": os.uname().machine,
        "commands": {name: bool(shutil.which(name)) for name in commands},
        "service": service_state(), "incomingLimitBytes": 512 * 1024 * 1024,
        "expandedLimitBytes": 1024 * 1024 * 1024, "fileLimit": 50_000,
        "incomingAggregateLimitBytes": 2 * 1024 * 1024 * 1024,
        "incomingTreeLimit": 4,
        "uploadLock": str(UPLOAD_LOCK),
        "identities": {
            "ingress": "marks-deploy",
            "build": "marks-build",
            "buildUid": build_uid,
            "buildGid": build_gid,
            "service": "devuser",
        },
        # The deployment client refuses to proceed when these identities
        # differ from the checked-in deploy/host sources, so a green
        # repository test can never silently certify a different installed
        # implementation.
        "helpers": {
            "dispatcher": hash_file(DISPATCHER),
            "uploader": hash_file(UPLOADER),
            "sqliteWorker": hash_file(SQLITE_WORKER),
            "releaseRoot": hash_file(RELEASE_ROOT),
            "serviceTemplate": hash_file(TEMPLATE),
        },
        "operations": ["probe", "upload", "cleanup", "deploy", "rollback", "status", "releases"],
        "target": {"origin": PUBLIC_ORIGIN, "productVariant": TARGET_PRODUCT_VARIANT},
        "buildFilesystem": {
            "root": str(BUILD_ROOT),
            "capacityBytes": build_capacity,
            "minimumBytes": MIN_BUILD_FILESYSTEM_BYTES,
            "maximumBytes": MAX_BUILD_FILESYSTEM_BYTES,
        },
        "fetchEgress": fetch_egress,
    }
    print(json.dumps(value, sort_keys=True))


def main() -> None:
    if os.geteuid() != 0:
        fail("root helper must run as root")
    if len(sys.argv) < 2:
        fail("missing operation")
    operation = sys.argv[1]
    args = sys.argv[2:]
    allowed = {
        "probe", "status", "releases", "deploy", "rollback", "rollback-legacy"
    }
    if operation not in allowed:
        fail("unsupported root operation")
    ensure_layout(require_build=operation in ("probe", "deploy"))
    if operation in ("probe", "status", "releases"):
        if args: fail("read-only operation accepts no arguments")
        {"probe": probe, "status": status_command, "releases": releases_command}[operation]()
        return
    LOCK.touch(mode=0o600, exist_ok=True)
    with LOCK.open("r+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            fail("another Marks deployment or rollback holds the release lock")
        purge_stale_release_staging()
        if operation == "deploy":
            if len(args) != 3:
                fail("deploy requires revision, product variant, and build plan digest")
            build_deploy(sha(args[0]), product_variant(args[1]), build_plan_sha256(args[2]))
        elif operation == "rollback":
            if len(args) > 1: fail("rollback accepts at most one release id")
            rollback(args[0] if args else None)
        else:
            require_local_break_glass()
            if len(args) != 1:
                fail("rollback-legacy requires one explicit legacy or v1 release id")
            requested = release_id(args[0])
            if not (
                requested.startswith("legacy-")
                or SHA_RE.fullmatch(requested)
            ):
                fail("rollback-legacy accepts only legacy or revision-only v1 release ids")
            rollback(requested, allow_legacy=True)


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"marks-release-root: {error}", file=sys.stderr)
        raise SystemExit(1)
