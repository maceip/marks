def ensure_real_directory(
    path: Path,
    mode: int,
    owner,
    *,
    parents: bool,
    allowed_existing_owners=None,
) -> None:
    """Create or harden one directory without ever following its final path."""
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
    except FileNotFoundError:
        path.mkdir(mode=mode, parents=parents, exist_ok=False)
        descriptor = os.open(path, flags)
    except OSError as error:
        fail(f"layout path is not a real directory: {path}: {error}")
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISDIR(info.st_mode):
            fail(f"layout path is not a directory: {path}")
        if (
            os.geteuid() == 0
            and allowed_existing_owners is not None
            and (info.st_uid, info.st_gid) not in allowed_existing_owners
        ):
            fail(f"layout directory has an unexpected owner: {path}")
        if os.geteuid() == 0:
            os.fchown(descriptor, *owner)
        os.fchmod(descriptor, mode)
    finally:
        os.close(descriptor)


def ensure_upload_lock() -> None:
    """Create or validate the uploader's fixed no-follow namespace lock."""
    uid, gid = deploy_identity()
    directory_fd = os.open(
        INCOMING, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    )
    descriptor = None
    try:
        try:
            descriptor = os.open(
                UPLOAD_LOCK.name,
                os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW,
                0o600,
                dir_fd=directory_fd,
            )
        except OSError as error:
            fail(f"upload namespace lock could not be opened safely: {error}")
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            fail("upload namespace lock must be one regular single-link file")
        allowed = {(uid, gid), (0, 0)}
        if (info.st_uid, info.st_gid) not in allowed:
            fail("upload namespace lock has an unexpected owner")
        if os.geteuid() == 0:
            os.fchown(descriptor, uid, gid)
        os.fchmod(descriptor, 0o600)
    finally:
        if descriptor is not None:
            os.close(descriptor)
        os.close(directory_fd)


def decode_mountinfo_field(value: str) -> str:
    """Decode the only escapes permitted by proc(5) mountinfo."""
    replacements = {
        "\\040": " ",
        "\\011": "\t",
        "\\012": "\n",
        "\\134": "\\",
    }
    for encoded, decoded in replacements.items():
        value = value.replace(encoded, decoded)
    return value


def build_mount_record(path: Path, mountinfo=Path("/proc/self/mountinfo")):
    """Return the one kernel mount record whose mount point is exactly path."""
    descriptor = os.open(mountinfo, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        data = bytearray()
        while len(data) <= MAX_MOUNTINFO_BYTES:
            block = os.read(
                descriptor,
                min(8192, MAX_MOUNTINFO_BYTES + 1 - len(data)),
            )
            if not block:
                break
            data.extend(block)
        if len(data) > MAX_MOUNTINFO_BYTES:
            fail("kernel mount table exceeds its parsing bound")
    finally:
        os.close(descriptor)
    try:
        lines = data.decode("utf-8", errors="strict").splitlines()
    except UnicodeDecodeError as error:
        fail(f"kernel mount table is not valid UTF-8: {error}")

    records = []
    for line in lines:
        fields = line.split()
        try:
            separator = fields.index("-")
        except ValueError:
            fail("kernel mount table contains a malformed record")
        if separator < 6 or len(fields) < separator + 4:
            fail("kernel mount table contains a truncated record")
        mount_point = Path(decode_mountinfo_field(fields[4]))
        if mount_point != path:
            continue
        try:
            major_text, minor_text = fields[2].split(":", 1)
            device = (int(major_text), int(minor_text))
        except (TypeError, ValueError):
            fail("build filesystem mount has an invalid device identity")
        records.append({
            "device": device,
            "root": decode_mountinfo_field(fields[3]),
            "mountPoint": mount_point,
            "options": set(fields[5].split(",")),
            "fileSystem": fields[separator + 1],
            "source": decode_mountinfo_field(fields[separator + 2]),
            "superOptions": set(fields[separator + 3].split(",")),
        })
    if len(records) != 1:
        fail("build root must be exactly one explicit filesystem mount")
    return records[0]


def validate_build_filesystem_contract(build_info, state_info, filesystem, mount) -> int:
    """Pure structural checks for the bounded build-filesystem contract."""
    if not stat.S_ISDIR(build_info.st_mode):
        fail("build root is not a directory")
    if (build_info.st_uid, build_info.st_gid) != (0, 0):
        fail("build root must be owned by root")
    if build_info.st_mode & 0o022:
        fail("build root must not be group/world-writable")
    if build_info.st_dev == state_info.st_dev:
        fail("build root must be a distinct filesystem from deployment state")
    if mount.get("root") != "/" or mount.get("fileSystem") != "ext4":
        fail("build root must be the root of a dedicated ext4 filesystem")
    if not {"nodev", "nosuid"}.issubset(mount.get("options", set())):
        fail("build filesystem must be mounted nodev,nosuid")
    observed_device = (os.major(build_info.st_dev), os.minor(build_info.st_dev))
    if mount.get("device") != observed_device:
        fail("build root device differs from its kernel mount record")
    block_size = filesystem.f_frsize or filesystem.f_bsize
    capacity = block_size * filesystem.f_blocks
    if not MIN_BUILD_FILESYSTEM_BYTES <= capacity <= MAX_BUILD_FILESYSTEM_BYTES:
        fail(
            "build filesystem capacity must be between "
            f"{MIN_BUILD_FILESYSTEM_BYTES} and {MAX_BUILD_FILESYSTEM_BYTES} bytes"
        )
    return capacity


def validate_loop_backing_contract(backing_info, build_device: int) -> None:
    """A loop filesystem is hard-bounded only when its image is allocated."""
    if not stat.S_ISREG(backing_info.st_mode):
        fail("build loop backing is not a regular file")
    if (backing_info.st_uid, backing_info.st_gid) != (0, 0):
        fail("build loop backing must be owned by root")
    if backing_info.st_mode & 0o022:
        fail("build loop backing must not be group/world-writable")
    if not MIN_BUILD_FILESYSTEM_BYTES <= backing_info.st_size <= MAX_BUILD_FILESYSTEM_BYTES:
        fail("build loop backing has an unexpected size")
    if backing_info.st_blocks * 512 < backing_info.st_size:
        fail("build loop backing is sparse; allocate every byte before mounting")
    if backing_info.st_dev == build_device:
        fail("build loop backing must live outside the filesystem it provides")


def validate_build_filesystem() -> int:
    """Verify the admin-provisioned hard disk boundary before any build."""
    try:
        build_fd = os.open(BUILD_ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError as error:
        fail(f"bounded build filesystem is not provisioned at {BUILD_ROOT}: {error}")
    try:
        state_fd = os.open(STATE, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            build_info = os.fstat(build_fd)
            state_info = os.fstat(state_fd)
            filesystem = os.fstatvfs(build_fd)
        finally:
            os.close(state_fd)
        mount = build_mount_record(BUILD_ROOT)
        capacity = validate_build_filesystem_contract(
            build_info,
            state_info,
            filesystem,
            mount,
        )

        source = Path(mount["source"])
        try:
            source_info = source.stat()
        except OSError as error:
            fail(f"build filesystem source is unavailable: {error}")
        if not stat.S_ISBLK(source_info.st_mode):
            fail("build filesystem source must be a fixed-size block device")
        source_device = (os.major(source_info.st_rdev), os.minor(source_info.st_rdev))
        if source_device != mount["device"]:
            fail("build filesystem source device differs from its mount record")

        loop_backing = (
            Path("/sys/dev/block")
            / f"{source_device[0]}:{source_device[1]}"
            / "loop"
            / "backing_file"
        )
        if loop_backing.exists():
            try:
                backing_fd = os.open(loop_backing, os.O_RDONLY | os.O_NOFOLLOW)
                try:
                    backing_bytes = os.read(
                        backing_fd,
                        MAX_LOOP_BACKING_PATH_BYTES + 1,
                    )
                finally:
                    os.close(backing_fd)
                if len(backing_bytes) > MAX_LOOP_BACKING_PATH_BYTES:
                    fail("build loop backing identity exceeds its parsing bound")
                encoded = backing_bytes.decode("utf-8", errors="strict").strip()
            except (OSError, UnicodeDecodeError) as error:
                fail(f"build loop backing identity is unreadable: {error}")
            if not encoded or "\n" in encoded or "\x00" in encoded:
                fail("build loop backing identity is invalid")
            backing = Path(encoded if encoded.startswith("/") else f"/{encoded}")
            if backing != BUILD_LOOP_IMAGE:
                fail(f"build loop backing must be the fixed {BUILD_LOOP_IMAGE} image")
            try:
                backing_info = backing.lstat()
            except OSError as error:
                fail(f"build loop backing is unavailable: {error}")
            if stat.S_ISLNK(backing_info.st_mode):
                fail("build loop backing must not be a symbolic link")
            validate_loop_backing_contract(backing_info, build_info.st_dev)
        return capacity
    finally:
        os.close(build_fd)


def ensure_layout(*, require_build=True) -> None:
    uid, gid = deploy_identity()
    state_children = (
        INCOMING, CLAIMED, CANARY, SQLITE_STAGING, SQLITE_ARCHIVE, BUILD_ROOT
    )
    if any(path.parent != STATE for path in state_children):
        fail("deployment state paths do not share the fixed state root")
    if any(path.parent != BUILD_ROOT for path in (CACHE, WORKSPACES, VERIFIED_GIT)):
        fail("build cache, workspaces, and Git verification must share the fixed build root")
    migration_owners = {(0, 0), (uid, gid)}
    # This must happen before touching any deploy-owned child. Once STATE is
    # root-owned and not group/world-writable, the uploader cannot rename or
    # replace cache, claim, workspace, incoming, or canary mount points.
    ensure_real_directory(
        STATE,
        0o755,
        (0, 0),
        parents=True,
        allowed_existing_owners=migration_owners,
    )
    if require_build:
        if os.geteuid() == 0:
            validate_build_filesystem()
        else:
            # Fixture-only branch. A non-root process cannot mount a loop/LV;
            # the pure contract above is tested independently.
            ensure_real_directory(
                BUILD_ROOT,
                0o755,
                (uid, gid),
                parents=False,
            )

    for path, mode, owner in (
        (RELEASES, 0o755, (0, 0)),
        (ASSET_POOL, 0o755, (0, 0)),
        (MARKS_ROOT / "deploy", 0o755, (0, 0)),
        (INCOMING, 0o700, (uid, gid)),
        (CLAIMED, 0o700, (0, 0)),
        (CANARY, 0o700, (0, 0)),
        (SQLITE_STAGING, 0o700, (0, 0)),
        (SQLITE_ARCHIVE, 0o700, (0, 0)),
    ):
        ensure_real_directory(path, mode, owner, parents=True)

    ensure_upload_lock()

    if not require_build:
        return
    ensure_real_directory(WORKSPACES, 0o700, (0, 0), parents=False)
    ensure_real_directory(VERIFIED_GIT, 0o700, (0, 0), parents=False)

    # No writable tool state persists across releases. Keep the legacy cache
    # root empty, root-owned, and non-writable so stale npm/Cargo state can be
    # retired under the deploy lock without creating a new trust channel.
    ensure_real_directory(
        CACHE,
        0o755,
        (0, 0),
        parents=True,
        allowed_existing_owners=migration_owners,
    )


def claim_uploaded_source(revision: str) -> Path:
    """Atomically remove one completed upload from the uploader namespace."""
    source = INCOMING / sha(revision)
    try:
        info = source.lstat()
    except FileNotFoundError:
        fail("no completed upload exists for this revision")
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
        fail("completed upload is not a real directory")
    claimed = CLAIMED / f"{revision}.{os.getpid()}"
    if claimed.exists() or claimed.is_symlink():
        fail("claimed source path already exists")
    os.rename(source, claimed)
    return claimed


def purge_stale_claims() -> None:
    """The deploy lock makes every pre-existing root claim abandoned."""
    pattern = re.compile(r"[0-9a-f]{40}\.[0-9]+")
    for entry in CLAIMED.iterdir():
        info = entry.lstat()
        if not pattern.fullmatch(entry.name) or not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
            fail(f"claim directory contains an unexpected object: {entry}")
        shutil.rmtree(entry)


def freeze_claimed_source(source: Path) -> None:
    """Validate and make a claimed Git archive root-owned and immutable."""
    if source.resolve().parent != CLAIMED.resolve():
        fail("claimed source escapes the root-only claim directory")
    uid, gid = deploy_identity()
    expected_owner = (uid, gid)
    entries = [source]
    file_count = 0
    byte_count = 0
    for root, dirs, files in os.walk(source, topdown=True, followlinks=False):
        for name in dirs + files:
            item = Path(root) / name
            info = item.lstat()
            if stat.S_ISLNK(info.st_mode) or not (
                stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)
            ):
                fail(f"claimed source contains an unsupported object: {item.relative_to(source)}")
            if (info.st_uid, info.st_gid) != expected_owner:
                fail(f"claimed source has an unexpected owner: {item.relative_to(source)}")
            entries.append(item)
            file_count += 1
            if stat.S_ISREG(info.st_mode):
                byte_count += info.st_size
                if info.st_nlink != 1:
                    fail(f"claimed source file has multiple links: {item.relative_to(source)}")
            if file_count > MAX_SOURCE_FILES or byte_count > MAX_SOURCE_BYTES:
                fail("claimed source exceeds the upload expansion limits")
    root_info = source.lstat()
    if (root_info.st_uid, root_info.st_gid) != expected_owner:
        fail("claimed source root has an unexpected owner")

    # Change children before their parents. The root-only CLAIMED parent has
    # already removed every uploader path to this inode tree.
    for item in sorted(entries, key=lambda path: len(path.parts), reverse=True):
        info = item.lstat()
        if os.geteuid() == 0:
            os.chown(item, 0, 0, follow_symlinks=False)
        if stat.S_ISDIR(info.st_mode):
            os.chmod(item, 0o555)
        else:
            os.chmod(item, 0o555 if info.st_mode & 0o111 else 0o444)


def copy_claimed_workspace(source: Path, revision: str) -> Path:
    """Create a hidden writable build copy from the immutable claimed tree."""
    workspace = WORKSPACES / f"{sha(revision)}.{os.getpid()}"
    if workspace.exists() or workspace.is_symlink():
        fail("build workspace already exists")
    workspace.mkdir(mode=0o700)
    uid, gid = build_identity()
    try:
        for root, dirs, files in os.walk(source, topdown=True, followlinks=False):
            relative_root = Path(root).relative_to(source)
            destination_root = workspace / relative_root
            for name in dirs:
                item = Path(root) / name
                info = item.lstat()
                if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
                    fail(f"claimed source directory changed during copy: {item}")
                destination = destination_root / name
                destination.mkdir(mode=0o700)
                if os.geteuid() == 0:
                    os.chown(destination, uid, gid)
            for name in files:
                item = Path(root) / name
                info = item.lstat()
                if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
                    fail(f"claimed source file changed during copy: {item}")
                destination = destination_root / name
                source_fd = os.open(item, os.O_RDONLY | os.O_NOFOLLOW)
                destination_fd = os.open(
                    destination,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                    0o600,
                )
                try:
                    while True:
                        block = os.read(source_fd, 1024 * 1024)
                        if not block:
                            break
                        remaining = memoryview(block)
                        while remaining:
                            written = os.write(destination_fd, remaining)
                            remaining = remaining[written:]
                    os.fchmod(destination_fd, 0o755 if info.st_mode & 0o111 else 0o644)
                    if os.geteuid() == 0:
                        os.fchown(destination_fd, uid, gid)
                finally:
                    os.close(source_fd)
                    os.close(destination_fd)
        if os.geteuid() == 0:
            os.chown(workspace, uid, gid)
        return workspace
    except Exception:
        shutil.rmtree(workspace, ignore_errors=True)
        raise


def verify_workspace_source(workspace: Path, git_dir: Path) -> None:
    """Require every tracked build input to still equal the claimed revision."""
    dirty = run(
        [
            "/usr/bin/git",
            f"--git-dir={git_dir}",
            f"--work-tree={workspace}",
            "status",
            "--porcelain=v1",
            "--untracked-files=no",
        ],
        capture=True,
        capture_limit=64 * 1024,
        env=fixed_environment(),
    ).stdout
    if dirty:
        fail("build workspace modified tracked source files")


def under_releases(path: Path) -> Path:
    resolved = path.resolve(strict=True)
    root = RELEASES.resolve(strict=True)
    if resolved.parent != root:
        fail(f"release escapes fixed release root: {resolved}")
    return resolved


def link_target(link: Path):
    if not link.is_symlink():
        return None
    try:
        return under_releases(link)
    except (FileNotFoundError, RuntimeError):
        return None


def hash_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def read_bounded_json_file(path: Path, label: str, limit: int):
    """Read one regular no-follow JSON file without trusting its size first."""
    if limit <= 0:
        fail("JSON file limit must be positive")
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError as error:
        fail(f"{label} could not be opened safely: {error}")
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
            fail(f"{label} is not one regular unlinked file")
        if before.st_size <= 0 or before.st_size > limit:
            fail(f"{label} exceeds its {limit}-byte limit")
        data = bytearray()
        while len(data) <= limit:
            block = os.read(descriptor, min(8192, limit + 1 - len(data)))
            if not block:
                break
            data.extend(block)
        if len(data) > limit:
            fail(f"{label} exceeds its {limit}-byte limit")
        after = os.fstat(descriptor)
        if (
            before.st_dev,
            before.st_ino,
            before.st_size,
            before.st_mtime_ns,
            before.st_ctime_ns,
        ) != (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_mtime_ns,
            after.st_ctime_ns,
        ):
            fail(f"{label} changed while it was read")
    finally:
        os.close(descriptor)
    try:
        return json.loads(data.decode("utf-8", errors="strict"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        fail(f"{label} is not valid UTF-8 JSON: {error}")


def read_bounded_regular_bytes(path: Path, label: str, limit: int) -> bytes:
    """Read immutable policy input through a regular no-follow descriptor."""
    if limit <= 0:
        fail("bounded file limit must be positive")
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
            fail(f"{label} is not one regular single-link file")
        if before.st_size <= 0 or before.st_size > limit:
            fail(f"{label} exceeds its {limit}-byte limit")
        data = bytearray()
        while len(data) <= limit:
            block = os.read(descriptor, min(8192, limit + 1 - len(data)))
            if not block:
                break
            data.extend(block)
        if len(data) > limit:
            fail(f"{label} exceeds its {limit}-byte limit")
        after = os.fstat(descriptor)
        fingerprint = lambda value: (
            value.st_dev, value.st_ino, value.st_size,
            value.st_mtime_ns, value.st_ctime_ns,
        )
        if fingerprint(before) != fingerprint(after):
            fail(f"{label} changed while it was read")
        return bytes(data)
    except OSError as error:
        fail(f"{label} could not be read safely: {error}")
    finally:
        os.close(descriptor)


def validate_release(path: Path, *, require_current_template=True) -> Path:
    release = under_releases(path)
    required = ("marks-server", "marks-admin", "marks.service", "release.json", "SHA256SUMS", "static/index.html")
    for relative in required:
        candidate = release / relative
        if not candidate.is_file() or candidate.is_symlink():
            fail(f"release is missing a regular {relative}")
    for root, dirs, files in os.walk(release, followlinks=False):
        for name in dirs + files:
            item = Path(root) / name
            info = item.lstat()
            if stat.S_ISLNK(info.st_mode) or not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
                fail(f"release contains an unsupported filesystem object: {item}")
            expected_uid = 0 if os.geteuid() == 0 else os.getuid()
            expected_gid = 0 if os.geteuid() == 0 else os.getgid()
            if info.st_uid != expected_uid or info.st_gid != expected_gid or info.st_mode & 0o022:
                fail(f"release is not root-owned and sealed: {item}")
    if TEMPLATE.read_bytes() != (release / "marks.service").read_bytes():
        # A release sealed under an older unit template stays valid for
        # rollback — activation always installs the current template — but a
        # forward deployment must never certify a stale unit.
        if require_current_template:
            fail("release unit differs from the root-owned Marks unit template")
        print(f"note: {release.name} was sealed under an older unit template")
    receipt = json.loads((release / "release.json").read_text(encoding="utf-8"))
    schema = receipt.get("schema")
    if schema not in ("marks-release.v1", RELEASE_SCHEMA) or not SHA_RE.fullmatch(
        str(receipt.get("revision", ""))
    ):
        fail("release receipt is invalid")
    if schema == RELEASE_SCHEMA:
        variant = receipt.get("productVariant")
        digest = receipt.get("buildPlanSha256")
        plan = receipt.get("buildPlan")
        if (
            not isinstance(plan, dict)
            or plan.get("schema") != BUILD_PLAN_SCHEMA
            or plan.get("productVariant") != variant
            or plan.get("features") != receipt.get("features")
            or plan.get("server", {}).get("cargoFeatures") != receipt.get("serverCargoFeatures")
        ):
            fail("release receipt build plan is incoherent")
        canonical = canonical_json(plan)
        if hashlib.sha256(canonical.encode("utf-8")).hexdigest() != digest:
            fail("release receipt build plan digest is invalid")
        expected_name = release_identity(receipt["revision"], variant, digest)
        if release.name != expected_name or receipt.get("releaseId") != expected_name:
            fail("release directory identity differs from its receipt")
        static_receipt_path = release / "static" / "marks-product-build.json"
        if not static_receipt_path.is_file() or static_receipt_path.is_symlink():
            fail("release is missing a regular static product build receipt")
        static_receipt = read_bounded_json_file(
            static_receipt_path,
            "static product build receipt",
            MAX_BUILD_RECEIPT_BYTES,
        )
        if static_receipt != {
            "schema": BUILD_PLAN_RECEIPT_SCHEMA,
            "buildPlan": plan,
            "buildPlanSha256": digest,
        }:
            fail("static product build receipt differs from the release receipt")
    declared = set()
    for line in (release / "SHA256SUMS").read_text(encoding="utf-8").splitlines():
        digest, marker, relative = line.partition("  ")
        if marker != "  " or not re.fullmatch(r"[0-9a-f]{64}", digest):
            fail("release checksum manifest is malformed")
        candidate = Path(relative)
        if candidate.is_absolute() or ".." in candidate.parts or relative == "SHA256SUMS":
            fail("release checksum path is unsafe")
        target = release / candidate
        if not target.is_file() or target.is_symlink() or hash_file(target) != digest:
            fail(f"release checksum failed: {relative}")
        declared.add(relative)
    actual = {
        str(item.relative_to(release))
        for item in release.rglob("*")
        if item.is_file() and not item.is_symlink() and item.name != "SHA256SUMS"
    }
    if declared != actual:
        fail("release checksum manifest does not cover exactly every release file")
    return release


def atomic_link(target: Path, link: Path) -> None:
    target = under_releases(target)
    temporary = link.with_name(f".{link.name}.new.{os.getpid()}")
    try:
        temporary.symlink_to(target)
        os.replace(temporary, link)
    finally:
        temporary.unlink(missing_ok=True)


def url_json(url: str, timeout=10):
    """Fetch one small JSON receipt under a wall-clock and byte bound.

    curl's max-time is an overall transfer deadline rather than a per-read
    socket timeout. max-filesize rejects an oversized declared Content-Length,
    while run(capture_limit=...) bounds streaming/chunked bodies before UTF-8
    decoding or JSON parsing in this root process.
    """
    if timeout <= 0:
        fail("HTTP receipt deadline has elapsed")
    result = run(
        [
            "/usr/bin/curl",
            "--disable",
            "--fail",
            "--silent",
            "--show-error",
            "--max-time",
            f"{max(0.001, float(timeout)):.3f}",
            "--max-filesize",
            str(MAX_HTTP_JSON_BYTES),
            "--header",
            "Accept: application/json",
            url,
        ],
        capture=True,
        capture_limit=MAX_HTTP_JSON_BYTES,
        env=fixed_environment(),
    )
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        fail(f"{url} did not return valid bounded JSON: {error}")


def wait_ready(
    origin: str,
    revision: str,
    *,
    legacy=False,
    build_plan=None,
    timeout=60,
    fetch_json=None,
) -> None:
    deadline = time.monotonic() + timeout
    last = "not ready"
    fetch_json = fetch_json or url_json

    def receipt(path: str):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            fail("readiness deadline elapsed")
        return fetch_json(f"{origin}{path}", min(5.0, remaining))

    while time.monotonic() < deadline:
        try:
            health = receipt("/healthz")
            if health.get("ok") is not True:
                fail("health response lacks ok=true")
            if legacy:
                return
            ready = receipt("/readyz")
            artifact = receipt("/v1/artifact")
            required = {
                "buildRevision": revision,
                "serverSourceDirty": False,
                "componentSourceDirty": False,
                "staticArtifactVerified": True,
                "profileCoherent": True,
                "engineCoherent": True,
                "releaseReady": True,
            }
            if build_plan is not None:
                required.update({
                    "productVariant": build_plan["productVariant"],
                    "buildPlanSha256": hashlib.sha256(
                        canonical_json(build_plan).encode("utf-8")
                    ).hexdigest(),
                    "features": build_plan["features"],
                    "serverFeatures": build_plan["server"]["cargoFeatures"],
                    "staticBuildPlanVerified": True,
                })
            if ready.get("ok") is not True or any(artifact.get(key) != value for key, value in required.items()):
                fail("readiness or artifact receipt does not match the release")
            if build_plan is not None and any(
                ready.get(key) != required[key]
                for key in ("productVariant", "buildPlanSha256")
            ):
                fail("readiness product variant does not match the release")
            return
        except Exception as error:
            last = str(error)
            remaining = deadline - time.monotonic()
            if remaining > 0:
                time.sleep(min(1.0, remaining))
    fail(f"timed out waiting for {origin}: {last}")


def validate_node_dependency_policy(source: Path) -> None:
    if any(source.rglob(".npmrc")):
        fail("repository .npmrc files are forbidden in production builds")
    lock = read_bounded_json_file(
        source / "package-lock.json",
        "npm dependency lock",
        MAX_DEPENDENCY_LOCK_BYTES,
    )
    packages = lock.get("packages") if isinstance(lock, dict) else None
    if (
        type(lock.get("lockfileVersion")) is not int
        or lock["lockfileVersion"] < 2
        or not isinstance(packages, dict)
        or not packages
    ):
        fail("npm dependency lock has an unsupported shape")
    for package_path, package in packages.items():
        if not isinstance(package_path, str) or not isinstance(package, dict):
            fail("npm dependency lock contains an invalid package entry")
        resolved = package.get("resolved")
        if resolved is None:
            expected_workspace = {
                "": "marks",
                "client": "@marks/client",
            }.get(package_path)
            if (
                expected_workspace is None
                or package.get("name") != expected_workspace
                or not isinstance(package.get("version"), str)
                or package.get("link") is not None
                or package.get("integrity") is not None
            ):
                fail("npm dependency without a resolved source is not one exact workspace root")
            continue
        if resolved == "client" and package_path == "node_modules/@marks/client" and package.get("link") is True:
            continue
        if not isinstance(resolved, str):
            fail("npm dependency lock contains a non-string source")
        parsed = urllib.parse.urlsplit(resolved)
        if (
            parsed.scheme != "https"
            or parsed.hostname != "registry.npmjs.org"
            or parsed.port is not None
            or parsed.username is not None
            or parsed.password is not None
            or parsed.query
            or parsed.fragment
            or not parsed.path.startswith("/")
        ):
            fail(f"npm dependency source is outside registry.npmjs.org: {resolved}")
        if not re.fullmatch(r"sha512-[A-Za-z0-9+/]+={0,2}", str(package.get("integrity", ""))):
            fail("npm registry dependency lacks a pinned SHA-512 integrity")


def validate_cargo_dependency_policy(source: Path) -> None:
    cargo_config = source / ".cargo"
    if cargo_config.exists() or cargo_config.is_symlink():
        fail("repository .cargo configuration is forbidden in production builds")
    data = read_bounded_regular_bytes(
        source / "Cargo.lock",
        "Cargo dependency lock",
        MAX_DEPENDENCY_LOCK_BYTES,
    )
    try:
        lock = tomllib.loads(data.decode("utf-8", errors="strict"))
    except (UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
        fail(f"Cargo dependency lock is invalid: {error}")
    packages = lock.get("package") if isinstance(lock, dict) else None
    if not isinstance(packages, list) or not packages:
        fail("Cargo dependency lock has an unsupported shape")
    registry = "registry+https://github.com/rust-lang/crates.io-index"
    git_source = re.compile(
        r"git\+https://github\.com/maceip/ESBT-web\?rev=([0-9a-f]{40})#([0-9a-f]{40})"
    )
    for package in packages:
        if not isinstance(package, dict):
            fail("Cargo dependency lock contains an invalid package entry")
        dependency_source = package.get("source")
        if dependency_source is None:
            continue
        if dependency_source == registry:
            if not SHA256_RE.fullmatch(str(package.get("checksum", ""))):
                fail("crates.io dependency lacks a pinned checksum")
            continue
        matched = git_source.fullmatch(str(dependency_source))
        if matched and matched.group(1) == matched.group(2):
            continue
        fail(f"Cargo dependency source is not allowlisted: {dependency_source}")


