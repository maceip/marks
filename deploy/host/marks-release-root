def fail(message: str) -> None:
    raise RuntimeError(message)


def run(
    argv,
    *,
    check=True,
    capture=False,
    capture_limit=None,
    timeout=None,
    env=None,
    cwd=None,
):
    command = [str(item) for item in argv]
    if capture and capture_limit is not None:
        if timeout is not None:
            fail("bounded captures must carry their deadline in the sandboxed command")
        if capture_limit <= 0:
            fail("capture limit must be positive")
        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            env=env,
            cwd=cwd,
        )
        output = bytearray()
        assert process.stdout is not None
        try:
            while len(output) <= capture_limit:
                block = process.stdout.read(min(8192, capture_limit + 1 - len(output)))
                if not block:
                    break
                output.extend(block)
            if len(output) > capture_limit:
                process.kill()
                process.wait()
                fail(f"command output exceeded {capture_limit} bytes: {argv[0]}")
            returncode = process.wait()
        finally:
            if process.poll() is None:
                process.kill()
                process.wait()
            process.stdout.close()
        stdout = output.decode("utf-8", errors="strict")
        result = subprocess.CompletedProcess(command, returncode, stdout=stdout)
    else:
        if timeout is not None:
            if capture:
                fail("timed commands must stream rather than accumulate output")
            process = subprocess.Popen(
                command,
                env=env,
                cwd=cwd,
                start_new_session=True,
            )
            try:
                returncode = process.wait(timeout=timeout)
            except subprocess.TimeoutExpired:
                # Git may have a remote-http child and Docker has client-side
                # helpers. Kill the whole command session, then let callers
                # perform any daemon-owned cleanup (for example docker rm).
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait()
                fail(f"command timed out after {timeout} seconds: {argv[0]}")
            result = subprocess.CompletedProcess(command, returncode, stdout=None)
        else:
            result = subprocess.run(
                command,
                check=False,
                text=True,
                stdout=subprocess.PIPE if capture else None,
                stderr=subprocess.STDOUT if capture else None,
                env=env,
                cwd=cwd,
            )
    if check and result.returncode:
        detail = f": {result.stdout.strip()}" if capture and result.stdout else ""
        fail(f"command failed ({result.returncode}): {argv[0]}{detail}")
    return result


def sha(value: str) -> str:
    if not SHA_RE.fullmatch(value):
        fail("revision must be exactly 40 lowercase hexadecimal characters")
    return value


def release_id(value: str) -> str:
    if not RELEASE_RE.fullmatch(value):
        fail("release id is not one legacy, revision-only, or product-variant release identity")
    return value


def product_variant(value: str) -> str:
    if not PRODUCT_VARIANT_RE.fullmatch(value):
        fail("product variant must be one lowercase catalog identifier")
    return value


def build_plan_sha256(value: str) -> str:
    if not SHA256_RE.fullmatch(value):
        fail("build plan digest must be exactly 64 lowercase hexadecimal characters")
    return value


def release_identity(revision: str, variant: str, digest: str) -> str:
    return f"{sha(revision)}.{product_variant(variant)}.{build_plan_sha256(digest)}"


def canonical_json(value) -> str:
    return json.dumps(value, ensure_ascii=False, separators=(",", ":"), sort_keys=True)


def resolve_build_plan(source: Path, requested_variant: str, expected_digest: str):
    """Resolve one checked-in build plan through the repository CLI.

    The restricted caller supplies only an allowlisted catalog identifier and
    its CI-bound digest. Feature booleans, Cargo features, and client build
    inputs are never accepted from SSH or ambient root environment.
    """
    requested_variant = product_variant(requested_variant)
    expected_digest = build_plan_sha256(expected_digest)
    command = [
        NODE,
        "--experimental-strip-types",
        "scripts/product-variant.ts",
        "resolve",
        "--variant",
        requested_variant,
        "--data-mode",
        "service",
        "--format",
        "json",
    ]
    output = run_product_variant_resolver(source, command)
    try:
        resolved = json.loads(output)
    except json.JSONDecodeError as error:
        fail(f"product variant resolver did not return JSON: {error}")
    if set(resolved) != {"schema", "buildPlan", "buildPlanSha256"}:
        fail("product variant resolver receipt has an unexpected shape")
    if resolved.get("schema") != BUILD_PLAN_RECEIPT_SCHEMA:
        fail("product variant resolver receipt schema is unsupported")
    plan = resolved.get("buildPlan")
    if not isinstance(plan, dict) or set(plan) != {
        "schema", "productVariant", "deployable", "features", "client", "server"
    }:
        fail("product build plan has an unexpected shape")
    if plan.get("schema") != BUILD_PLAN_SCHEMA:
        fail("product build plan schema is unsupported")
    if plan.get("productVariant") != requested_variant:
        fail("resolved product variant differs from the requested variant")
    if plan.get("deployable") is not True:
        fail(f"product variant is not deployable: {requested_variant}")
    features = plan.get("features")
    if (
        not isinstance(features, dict)
        or not features
        or any(not PRODUCT_VARIANT_RE.fullmatch(str(name)) or type(enabled) is not bool
               for name, enabled in features.items())
    ):
        fail("product build plan features are invalid")
    client = plan.get("client")
    if client != {"dataMode": "service"}:
        fail("deployment requires a service-mode client build plan")
    server = plan.get("server")
    cargo_features = server.get("cargoFeatures") if isinstance(server, dict) else None
    if (
        not isinstance(cargo_features, list)
        or cargo_features != sorted(set(cargo_features))
        or any(not isinstance(name, str) or not CARGO_FEATURE_RE.fullmatch(name)
               for name in cargo_features)
    ):
        fail("product build plan server Cargo features are invalid")
    canonical = canonical_json(plan)
    observed_digest = hashlib.sha256(canonical.encode("utf-8")).hexdigest()
    if resolved.get("buildPlanSha256") != observed_digest:
        fail("product variant resolver digest does not match its canonical plan")
    if observed_digest != expected_digest:
        fail("requested build plan digest differs from the checked-in product variant")
    return {
        "plan": plan,
        "canonical": canonical,
        "digest": observed_digest,
        "variant": requested_variant,
        "cargoFeatures": cargo_features,
        "clientOutput": (
            source
            / "client"
            / "dist-variants"
            / requested_variant
            / f"service-{observed_digest[:16]}"
        ),
    }


def run_product_variant_resolver(source: Path, command) -> str:
    """Run repository-owned resolver code without root authority.

    Production invokes this helper as root, but the uploaded TypeScript and
    catalog are untrusted until their receipt has been validated. Execute them
    as the dedicated locked build uid in a read-only, networkless transient
    unit. Unprivileged contract tests can run the same command directly because
    they have no authority to shed.
    """
    return run_untrusted_readonly(
        source,
        command,
        step="plan",
        capture_limit=128 * 1024,
    )


def run_untrusted_readonly(
    working_directory: Path,
    command,
    *,
    step: str,
    capture_limit: int,
    sandbox_command=None,
) -> str:
    """Capture one repository-built program without ever giving it root.

    The production branch deliberately has no direct-execution fallback. The
    unprivileged branch exists only so the same helper can be exercised by the
    fixture suite without systemd or sudo.
    """
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,31}", step):
        fail("sandbox step name is invalid")
    if os.geteuid() != 0:
        return run(
            command,
            capture=True,
            capture_limit=capture_limit,
            env=fixed_environment(),
            cwd=working_directory,
        ).stdout

    uid, gid = build_identity()
    path_token = hashlib.sha256(str(working_directory).encode("utf-8")).hexdigest()[:12]
    unit = f"marks-{step}-{path_token}-{os.getpid()}"
    payload = command if sandbox_command is None else sandbox_command
    sandbox = [
        "/usr/bin/systemd-run",
        "--quiet",
        "--wait",
        "--pipe",
        "--collect",
        f"--unit={unit}",
        f"--uid={uid}",
        f"--gid={gid}",
        "--property=Type=exec",
        "--property=WorkingDirectory=/marks-input",
        f"--property=BindReadOnlyPaths={working_directory}:/marks-input",
        "--property=ProtectSystem=strict",
        "--property=ProtectHome=yes",
        "--property=PrivateTmp=yes",
        "--property=PrivateDevices=yes",
        "--property=PrivateNetwork=yes",
        "--property=ProtectProc=invisible",
        "--property=ProcSubset=pid",
        "--property=RuntimeMaxSec=30",
        "--property=MemoryMax=128M",
        "--property=TasksMax=32",
        "--property=NoNewPrivileges=yes",
        "--property=RestrictSUIDSGID=yes",
        "--property=CapabilityBoundingSet=",
        "--property=RestrictRealtime=yes",
        "--property=LockPersonality=yes",
        "--property=ProtectKernelTunables=yes",
        "--property=ProtectKernelModules=yes",
        "--property=ProtectControlGroups=yes",
        "--property=ReadOnlyPaths=/marks-input",
        "--property=InaccessiblePaths=/var/lib/marks /etc/marks /home /root /run/docker.sock",
        "--setenv=HOME=/tmp",
        "--setenv=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "--setenv=LANG=C.UTF-8",
        "--setenv=LC_ALL=C.UTF-8",
        "--setenv=GIT_TERMINAL_PROMPT=0",
        *payload,
    ]
    return run(sandbox, capture=True, capture_limit=capture_limit).stdout


def built_schema_receipt(stage: Path):
    """Read schema compatibility from a freshly built unprivileged payload."""
    output = run_untrusted_readonly(
        stage,
        [stage / "marks-admin", "schema"],
        step="schema",
        capture_limit=64 * 1024,
        sandbox_command=["/marks-input/marks-admin", "schema"],
    )
    try:
        receipt = json.loads(output.strip())
    except json.JSONDecodeError as error:
        fail(f"built marks-admin did not return a JSON schema identity: {error}")
    if set(receipt) != {"schemaVersion", "maxCompatibleSchema"}:
        fail("built marks-admin schema identity has an unexpected shape")
    if (
        type(receipt.get("schemaVersion")) is not int
        or type(receipt.get("maxCompatibleSchema")) is not int
        or receipt["schemaVersion"] < 0
        or receipt["maxCompatibleSchema"] < receipt["schemaVersion"]
    ):
        fail("built marks-admin did not report a valid schema identity")
    return receipt


def deploy_identity():
    if os.geteuid() != 0:
        return os.getuid(), os.getgid()
    account = pwd.getpwnam("marks-deploy")
    return account.pw_uid, account.pw_gid


def build_identity():
    """Return the locked identity used only for untrusted build execution."""
    if os.geteuid() != 0:
        return os.getuid(), os.getgid()
    account = pwd.getpwnam("marks-build")
    deploy = pwd.getpwnam("marks-deploy")
    service = pwd.getpwnam("devuser")
    if (
        account.pw_uid in (0, deploy.pw_uid, service.pw_uid)
        or account.pw_gid in (0, deploy.pw_gid, service.pw_gid)
        or account.pw_shell not in ("/usr/sbin/nologin", "/sbin/nologin", "/bin/false")
    ):
        fail("marks-build must be one distinct locked system identity")
    return account.pw_uid, account.pw_gid


def service_identity():
    """Return the identity that owns and parses the live Marks database."""
    if os.geteuid() != 0:
        return os.getuid(), os.getgid()
    account = pwd.getpwnam("devuser")
    return account.pw_uid, account.pw_gid


